<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUI.Framework.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:converters="using:WinUI.Framework.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel Spacing="4" Margin="0,0,0,28">
        <TextBlock
            Text="{x:Bind Title, Mode=OneWay}"
            Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock
            Text="{x:Bind Subtitle, Mode=OneWay}"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="{x:Bind Subtitle, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}" />
    </StackPanel>
</UserControl>
