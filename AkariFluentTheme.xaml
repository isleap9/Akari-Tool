<!--
  AkariFluentTheme.xaml  —  THEME-AGNOSTIC styles/templates only.
  All per-theme Colors + Brushes now live in Themes/Akari.Dark.xaml /
  Akari.Light.xaml (swapped at runtime by ThemeService). Everything here
  resolves palette via {DynamicResource <token>} so it live-updates on switch.
  Merged AFTER the active Akari.*.xaml so these styles see its tokens.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ════════════════ RADIUS TOKENS ════════════════ -->
  <!-- The two radii the whole app uses, matching WinUI. Cards/containers/banners
       take the card radius; buttons, inputs and selection fills take the control
       radius. Never write a literal radius at a usage site — add a token if a
       genuinely new size is needed. Theme-agnostic, so they live here, not in
       the per-theme dictionaries. -->
  <CornerRadius x:Key="AkariCardRadius">8</CornerRadius>
  <CornerRadius x:Key="AkariControlRadius">4</CornerRadius>

  <!-- ════════════════ CARD ════════════════ -->
  <Style x:Key="AkariCard" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource AkariCardRadius}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Background" Value="{DynamicResource AkariCardBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AkariCardElevationBorder}"/>
  </Style>

  <Style x:Key="SectionHeader" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource AkariTextPrimary}"/>
    <Setter Property="Margin" Value="0,18,0,9"/>
  </Style>

  <!-- ════════════════ BADGE PILLS ════════════════ -->
  <Style x:Key="BadgeBase" TargetType="Border">
    <!-- design: CornerRadius 8 — do not change (999 is ADMIN chip + n-selected chip ONLY) -->
    <Setter Property="CornerRadius" Value="{StaticResource AkariControlRadius}"/>
    <Setter Property="Padding" Value="11,3"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- Recommended pill colours are intentionally fixed (crimson) in both themes. -->
  <Style x:Key="BadgeRecommended" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
    <Setter Property="Background"><Setter.Value><SolidColorBrush Color="#1AE0142A"/></Setter.Value></Setter>
    <Setter Property="BorderBrush"><Setter.Value><SolidColorBrush Color="#6BE0142A"/></Setter.Value></Setter>
  </Style>
  <!-- Neutral "Windows default" pill — routed through overlay tokens so it reads in both themes. -->
  <Style x:Key="BadgeWindowsDefault" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
    <Setter Property="Background" Value="{DynamicResource AkariOverlayFaint}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AkariOverlayStrong}"/>
  </Style>
  <Style x:Key="BadgeText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <!-- ════════════════ RUN BUTTON (crimson filled) ════════════════ -->
  <Style x:Key="RunBtn" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource AkariAccent}"/>
    <Setter Property="Foreground" Value="#F2F2F4"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="Margin" Value="4,0,0,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource AkariControlRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextElement.FontSize="{TemplateBinding FontSize}"
                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF2438"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#B3121F"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AkariHairline}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ════════════════ UNDO BUTTON (ghost outline) ════════════════ -->
  <Style x:Key="UndoBtn" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource AkariCardBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource AkariTextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AkariHairline}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="Margin" Value="4,0,0,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource AkariControlRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextElement.FontSize="{TemplateBinding FontSize}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AkariHairlineHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ════════════════ GRID BUTTON (frosted, for action grids) ════════════════ -->
  <Style x:Key="GridBtn" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource AkariCardBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource AkariTextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AkariHairline}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource AkariControlRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextElement.FontSize="{TemplateBinding FontSize}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AkariHairlineHover}"/>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AkariCardBackgroundHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AkariOverlayStrong}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ════════════════ CHECKBOX (crimson filled square) ════════════════ -->
  <Style x:Key="AppCheckBox" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource AkariTextPrimary}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="CheckBorder"
                    Width="16" Height="16"
                    CornerRadius="{StaticResource AkariControlRadius}"
                    Background="{DynamicResource AkariCardBackground}"
                    BorderBrush="{DynamicResource AkariHairline}"
                    BorderThickness="1.5"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    SnapsToDevicePixels="True">
              <TextBlock x:Name="CheckMark"
                         Text="✓"
                         FontSize="11"
                         FontWeight="Bold"
                         Foreground="#F2F2F4"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"/>
            </Border>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AkariAccent}"/>
              <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AkariAccent}"/>
              <Setter TargetName="CheckMark"   Property="Visibility"  Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AkariAccent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
