                    <Color x:Key="AkariWarnBorderColor">#FFEAD9A0</Color>
                    <Color x:Key="AkariDangerFgColor">#FFC01122</Color>
                    <Color x:Key="AkariDangerBgColor">#FFFDEBEC</Color>
                    <Color x:Key="AkariDangerBorderColor">#FFF3C0C5</Color>
                    <Color x:Key="AkariPillNeutralBgColor">#FFF1F1F4</Color>
                    <Color x:Key="AkariPillNeutralBorderColor">#FFD6D6DD</Color>
                    <Color x:Key="AkariPillNeutralFgColor">#FF4A4A52</Color>
                    <Color x:Key="AkariPillAccentBgColor">#00000000</Color>
                    <Color x:Key="AkariPillAccentBorderColor">#FFE0142A</Color>
                    <Color x:Key="AkariPillAccentFgColor">#FFE0142A</Color>
                    <Color x:Key="AkariAccentTextColor">#FFB01020</Color>
                    <Color x:Key="AkariAccentTextMutedColor">#FFB0424D</Color>
                    <Color x:Key="AkariStarGoldColor">#FFDBA400</Color>
                    <Color x:Key="AkariWinBlueIconColor">#FF0F82CE</Color>
                    <Color x:Key="AkariPillPreferenceColor">#FF7E5BC0</Color>
                    <Color x:Key="AkariPillRecommendedColor">#FFE0142A</Color>
                    <Color x:Key="AkariPillDefaultColor">#FF8E8E96</Color>
                    <Color x:Key="AkariPillCustomColor">#FFAAAAB2</Color>
