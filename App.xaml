                        <GradientStop Color="{StaticResource AkariCardElevationShadowColor}" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="AkariCardBackgroundHover" Color="{StaticResource AkariCardBackgroundHoverColor}"/>
                    <SolidColorBrush x:Key="AkariSidebarBackground" Color="{StaticResource AkariSidebarBackgroundColor}"/>
                    <SolidColorBrush x:Key="AkariHairline" Color="{StaticResource AkariHairlineColor}"/>
                    <SolidColorBrush x:Key="AkariHairlineHover" Color="{StaticResource AkariHairlineHoverColor}"/>
                    <SolidColorBrush x:Key="AkariTextPrimary" Color="{StaticResource AkariTextPrimaryColor}"/>
                    <SolidColorBrush x:Key="AkariTextSecondary" Color="{StaticResource AkariTextSecondaryColor}"/>
                    <SolidColorBrush x:Key="AkariTextMuted" Color="{StaticResource AkariTextMutedColor}"/>
                    <SolidColorBrush x:Key="AkariIconNeutral" Color="{StaticResource AkariIconNeutralColor}"/>
                    <SolidColorBrush x:Key="AkariAccent" Color="{StaticResource AkariAccentColor}"/>
                    <SolidColorBrush x:Key="AkariAccentFg" Color="{StaticResource AkariAccentFgColor}"/>
                    <SolidColorBrush x:Key="AkariLogSurface" Color="{StaticResource AkariLogSurfaceColor}"/>
                    <SolidColorBrush x:Key="AkariAccentText" Color="{StaticResource AkariAccentTextColor}"/>
                    <SolidColorBrush x:Key="AkariAccentTextMuted" Color="{StaticResource AkariAccentTextMutedColor}"/>
                    <SolidColorBrush x:Key="AkariSuccess" Color="{StaticResource AkariSuccessColor}"/>
                    <SolidColorBrush x:Key="AkariWarn" Color="{StaticResource AkariWarnColor}"/>
