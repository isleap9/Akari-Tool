<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AkariTool.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ═══════════════ AKARI THEME TOKENS ═══════════════
                 Ported from Themes/Akari.Dark.xaml + Akari.Light.xaml.
                 Key names kept identical (WPF {DynamicResource} → WinUI {ThemeResource}).
                 "Default" = dark, "Light" = light. ThemeService reads palette values
                 straight from these two dictionaries. DropShadowEffect keys are dropped
                 (no WinUI Effect); shadows become ThemeShadow later if reinstated. -->
            <ResourceDictionary.ThemeDictionaries>

                <!-- ─────────── DARK ─────────── -->
                <ResourceDictionary x:Key="Default">
                    <!-- legacy palette -->
                    <Color x:Key="AkariRed">#FFE0142A</Color>
                    <Color x:Key="AkariRedHot">#FFFF4150</Color>
                    <Color x:Key="AkariRedSoft">#FFFF6373</Color>
                    <Color x:Key="AkariBg">#FF0B0B0D</Color>
                    <Color x:Key="AkariPanel">#FF121215</Color>
                    <Color x:Key="AkariText">#FFF2F2F4</Color>
                    <Color x:Key="AkariTextMutedLegacy">#FF9A9AA0</Color>
                    <!-- v3 colours -->
                    <Color x:Key="AkariCanvasTop">#FF202020</Color>
                    <Color x:Key="AkariCanvasBottom">#FF202020</Color>
                    <Color x:Key="AkariContentSurfaceColor">#FF262626</Color>
                    <Color x:Key="AkariCardBackgroundColor">#FF2D2D2D</Color>
                    <Color x:Key="AkariCardBackgroundHoverColor">#FF323232</Color>
                    <Color x:Key="AkariSidebarBackgroundColor">#FF202020</Color>
                    <Color x:Key="AkariHairlineColor">#FF383838</Color>
                    <Color x:Key="AkariHairlineHoverColor">#FF484848</Color>
                    <Color x:Key="AkariCardElevationLitColor">#FF3A3A3A</Color>
                    <Color x:Key="AkariCardElevationShadowColor">#FF242424</Color>
                    <Color x:Key="AkariTextPrimaryColor">#FFFFFFFF</Color>
                    <Color x:Key="AkariTextSecondaryColor">#FFCCCCCC</Color>
                    <Color x:Key="AkariTextMutedColor">#FFA6A6A6</Color>
                    <Color x:Key="AkariIconNeutralColor">#FFB3B3B3</Color>
                    <Color x:Key="AkariAccentColor">#FFE0142A</Color>
                    <Color x:Key="AkariAccentHotColor">#FFFF2438</Color>
                    <!-- Fixed crimson tints (intentionally theme-invariant — same in both
                         dictionaries — for the "Recommended" pill + RunBtn pressed state). -->
                    <Color x:Key="AkariAccentSoftColor">#1AE0142A</Color>
                    <Color x:Key="AkariAccentBorderColor">#6BE0142A</Color>
                    <Color x:Key="AkariAccentPressedColor">#FFB3121F</Color>
                    <!-- Foreground for content sitting ON the crimson accent (RunBtn text,
                         checkbox ✓): white in BOTH themes. Reusable "on-accent" token. -->
                    <Color x:Key="AkariAccentFgColor">#FFF2F2F4</Color>
                    <!-- Fixed-brand green glow behind the status dot: invariant in both themes
                         (distinct from AkariSuccessColor, which is theme-variant). -->
                    <Color x:Key="AkariSuccessGlowColor">#FF3DDC84</Color>
                    <Color x:Key="AkariLogSurfaceColor">#FF0E0E0E</Color>
                    <Color x:Key="AkariSuccessColor">#FF3DDC84</Color>
                    <Color x:Key="AkariWarnColor">#FFF5C542</Color>
                    <Color x:Key="AkariWinBlueColor">#FF4CC2FF</Color>
                    <Color x:Key="StarGold">#FFF5C542</Color>
                    <Color x:Key="WinBlue">#FF4CC2FF</Color>
                    <Color x:Key="AkariSuccessFgColor">#FFA6E3A1</Color>
                    <Color x:Key="AkariSuccessBgColor">#14A6E3A1</Color>
                    <Color x:Key="AkariSuccessBorderColor">#33A6E3A1</Color>
                    <Color x:Key="AkariInfoFgColor">#FF4CC2FF</Color>
                    <Color x:Key="AkariInfoBgColor">#1A4CC2FF</Color>
                    <Color x:Key="AkariInfoBorderColor">#334CC2FF</Color>
                    <Color x:Key="AkariWarnFgColor">#FFF5C542</Color>
