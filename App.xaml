<Application x:Class="AkariTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AkariTool"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI core: theme + control templates (required by FluentWindow/TitleBar). -->
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
                <!-- Active Akari theme tokens (Dark default; swapped at runtime by ThemeService).
                     Kept BEFORE AkariFluentTheme so agnostic styles resolve these tokens. -->
                <ResourceDictionary Source="Themes/Akari.Dark.xaml"/>
                <!-- Akari agnostic styles LAST so its red accent + styles win over WPF-UI defaults. -->
                <ResourceDictionary Source="AkariFluentTheme.xaml"/>
                <ResourceDictionary Source="Themes/NavIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════ FONTS ═══════════════ -->
            <FontFamily x:Key="MaterialIcons">pack://application:,,,/Fonts/#Material Icons</FontFamily>
            <!-- Windows 11 system typography. Segoe UI Variable ships in three optical sizes;
                 Segoe UI is the fallback for Win10 / machines without the variable family. -->
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Variable, Segoe UI</FontFamily>
            <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI Variable, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

            <!-- ═══════════════ SCROLLBAR (thin) ═══════════════ -->
            <Style x:Key="AppScrollBarThumb" TargetType="Thumb">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="ThumbBd" CornerRadius="2" Margin="1"
                                    Background="{DynamicResource AkariOverlayStrong}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AkariHairlineHover}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AkariHairlineHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AppScrollBarRepeatButton" TargetType="RepeatButton">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton"><Border Width="0" Height="0"/></ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AppScrollBar" TargetType="ScrollBar">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Width" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource AppScrollBarRepeatButton}" Command="ScrollBar.LineUpCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource AppScrollBarThumb}"/></Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource AppScrollBarRepeatButton}" Command="ScrollBar.LineDownCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource AppScrollBarRepeatButton}" Command="ScrollBar.LineLeftCommand"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb><Thumb Style="{StaticResource AppScrollBarThumb}"/></Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource AppScrollBarRepeatButton}" Command="ScrollBar.LineRightCommand"/>
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- implicit ScrollBar app-wide -->
            <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBar}"/>

            <Style x:Key="AppScrollViewer" TargetType="ScrollViewer">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ScrollContentPresenter Grid.Column="0" Grid.Row="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0"
                                           Style="{StaticResource AppScrollBar}" Orientation="Vertical"
                                           Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1"
                                           Style="{StaticResource AppScrollBar}" Orientation="Horizontal"
                                           Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}"
                                           ViewportSize="{TemplateBinding ViewportWidth}"
                                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBox: styled by the WPF-UI implicit style (ui:ControlsDictionary). -->

            <!-- ═══════════════ SEPARATOR reset (no negative-margin bleed) ═══════════════ -->
            <Style TargetType="Separator" BasedOn="{x:Null}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource AkariOverlayStrong}"/>
                <Setter Property="Height" Value="1"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator"><Border Background="{TemplateBinding Background}"/></ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════ GENERIC BUTTONS (tab content) ═══════════════ -->
            <ControlTemplate x:Key="AppButtonTemplate" TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource AkariControlRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="AppButton" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="#e0142a"/>
                <Setter Property="Foreground" Value="#0c0506"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template" Value="{StaticResource AppButtonTemplate}"/>
            </Style>
            <Style x:Key="AppButtonSecondary" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource AkariTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AkariHairline}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template" Value="{StaticResource AppButtonTemplate}"/>
            </Style>
            <!-- Read-only mono log console box -->
            <Style x:Key="AkariLogBox" TargetType="TextBox" BasedOn="{x:Null}">
                <Setter Property="Background" Value="{DynamicResource AkariLogSurface}"/>
                <Setter Property="Foreground" Value="{DynamicResource AkariTextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AkariHairline}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource AkariControlRadius}" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- alias used by some markup -->
            <Style x:Key="LogTextBox" TargetType="TextBox" BasedOn="{StaticResource AkariLogBox}"/>

            <!-- ═══════════════ NAV RAIL (unified templates driven by Nav.IsActive) ═══════════════ -->
            <Style x:Key="NavIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Width" Value="20"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Style.Triggers>
                    <!-- compact: drop the right gap so the icon centres cleanly -->
                    <DataTrigger Binding="{Binding Path=(local:Nav.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Margin" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Colored PNG nav icon: mirrors NavIcon's sizing + compact behaviour. -->
            <Style x:Key="NavImageIcon" TargetType="Image">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=(local:Nav.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Margin" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NavLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <!-- compact: hide the text, leaving the icon only -->
                    <DataTrigger Binding="{Binding Path=(local:Nav.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Theme-toggle icon geometry. The two source SVGs use different
                 viewBoxes, so each Canvas must match its own (8×8 moon, 24×24 sun). -->
            <Geometry x:Key="IconMoon">M2.72 0A3.99 3.99 0 0 0 0 3.78c0 2.21 1.79 4 4 4c1.76 0 3.25-1.14 3.78-2.72c-.4.13-.83.22-1.28.22c-2.21 0-4-1.79-4-4c0-.45.08-.88.22-1.28</Geometry>

            <Geometry x:Key="IconSunCore">M18 12a6 6 0 1 1-12 0a6 6 0 0 1 12 0</Geometry>

            <!-- Leading "F0" is the path mini-language form of fill-rule="evenodd"
                 (WPF's Path element has no FillRule property — it lives on the geometry). -->
            <Geometry x:Key="IconSunRays">F0 M12 1.25a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0V2a.75.75 0 0 1 .75-.75M4.399 4.399a.75.75 0 0 1 1.06 0l.393.392a.75.75 0 0 1-1.06 1.061l-.393-.393a.75.75 0 0 1 0-1.06m15.202 0a.75.75 0 0 1 0 1.06l-.393.393a.75.75 0 0 1-1.06-1.06l.393-.393a.75.75 0 0 1 1.06 0M1.25 12a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 0 1.5H2a.75.75 0 0 1-.75-.75m19 0a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 0 1.5h-1a.75.75 0 0 1-.75-.75m-2.102 6.148a.75.75 0 0 1 1.06 0l.393.393a.75.75 0 1 1-1.06 1.06l-.393-.393a.75.75 0 0 1 0-1.06m-12.296 0a.75.75 0 0 1 0 1.06l-.393.393a.75.75 0 1 1-1.06-1.06l.392-.393a.75.75 0 0 1 1.061 0M12 20.25a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0v-1a.75.75 0 0 1 .75-.75</Geometry>

            <!-- Hamburger: a fixed 40×40 square icon button whose hover/press
                 highlight hugs the icon instead of stretching across the whole
                 rail like TabBtn does. Left-aligned when expanded (lines up with
                 the tab icon column); centred when compact (lines up with the
                 centred tab icons below). -->
            <Style x:Key="HamburgerBtn" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource AkariNavText}"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Margin" Value="7,0,0,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Hi" CornerRadius="{StaticResource AkariControlRadius}" Margin="6" Background="Transparent" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Hi" Property="Background" Value="{DynamicResource AkariOverlayFaint}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AkariNavTextActive}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Hi" Property="Background" Value="{DynamicResource AkariOverlayMedium}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AkariNavTextActive}"/>
                                </Trigger>
                                <!-- compact: centre the button so it sits above the
                                     centred tab icons -->
                                <DataTrigger Binding="{Binding Path=(local:Nav.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TabBtn" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource AkariNavText}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="SelBd" CornerRadius="{StaticResource AkariControlRadius}" Margin="7,3" Background="Transparent" SnapsToDevicePixels="True"/>
                                <Border x:Name="Pill" Width="3" Height="15" CornerRadius="3" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0">
                                    <Border.Background><SolidColorBrush Color="#E01424"/></Border.Background>
                                    <Border.Effect><DropShadowEffect Color="#E0142A" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
                                </Border>
                                <ContentPresenter x:Name="Content" Margin="18,0,6,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SelBd" Property="Background" Value="{DynamicResource AkariOverlayFaint}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AkariNavTextActive}"/>
                                </Trigger>
                                <Trigger Property="local:Nav.IsActive" Value="True">
                                    <Setter TargetName="SelBd" Property="Background" Value="{DynamicResource AkariOverlaySoft}"/>
                                    <Setter TargetName="Pill" Property="Opacity" Value="1"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AkariNavTextActive}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <!-- compact: centre icon, drop the flush-left pill so every
                                     active tab's highlight box sits at the same X -->
                                <DataTrigger Binding="{Binding Path=(local:Nav.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter TargetName="Content" Property="Margin" Value="0"/>
                                    <Setter TargetName="Content" Property="HorizontalAlignment" Value="Center"/>
                                    <Setter TargetName="SelBd" Property="Margin" Value="6,3"/>
                                    <Setter TargetName="Pill" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════ NAVIGATIONVIEW (Akari rail skin) ═══════════════
                 Full retemplate: WPF-UI's stock pane template imposes its own width
                 animation (breaks the 49px compact rail), margins, and TextElement
                 font sizes (changes the rail typography). This template is the app's
                 original DockPanel rail verbatim, with the three PART_ elements
                 NavigationView requires. Compact stays driven by MainWindow.IsPaneCompact.
                 Fonts inherit from the window (BodyFont) exactly like the old rail. -->
            <Style x:Key="AkariNavView" TargetType="{x:Type ui:NavigationView}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:NavigationView}">
                            <Grid Background="Transparent">
                                <DockPanel>
                                    <!-- Footer (pinned bottom) -->
                                    <ItemsControl x:Name="PART_FooterMenuItemsItemsControl" DockPanel.Dock="Bottom"
                                                  Margin="0,0,0,10" Focusable="False"
                                                  ItemsSource="{TemplateBinding FooterMenuItems}"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Style="{StaticResource AppScrollViewer}">
                                        <StackPanel VerticalAlignment="Top" Margin="0,8,0,8">
                                            <ContentPresenter Content="{TemplateBinding PaneHeader}" Focusable="False"/>
                                            <ItemsControl x:Name="PART_MenuItemsItemsControl" Focusable="False"
                                                          ItemsSource="{TemplateBinding MenuItems}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                                <!-- Required template part; unused — page switching stays the
                                     Visibility-toggled UserControl stack outside the rail. -->
                                <ui:NavigationViewContentPresenter x:Name="PART_NavigationViewContentPresenter"
                                                                   Visibility="Collapsed" Width="0" Height="0"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════ NAVIGATIONVIEW ITEMS (Akari rail skin) ═══════════════
                 The rail is a ui:NavigationView; these templates reproduce the previous
                 hand-rolled TabBtn / SubSideBtn / group-header looks exactly, driven by
                 the control's native IsActive / IsExpanded instead of attached props. -->

            <!-- Leaf item (old TabBtn look). Also hosts optional children (Customize):
                 an ItemsControl bound to MenuItems, shown while IsExpanded. -->
            <Style x:Key="AkariNavItem" TargetType="{x:Type ui:NavigationViewItem}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource AkariNavText}"/>
                <!-- Pin font explicitly: items nested in a group would otherwise
                     inherit the group header's MonoFont/SemiBold. -->
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:NavigationViewItem}">
                            <StackPanel>
                                <Grid x:Name="Row" Background="Transparent" Height="40">
                                    <Border x:Name="SelBd" CornerRadius="{StaticResource AkariControlRadius}" Margin="7,3" Background="Transparent" SnapsToDevicePixels="True"/>
                                    <Border x:Name="Pill" Width="3" Height="15" CornerRadius="3" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0">
                                        <Border.Background><SolidColorBrush Color="#E01424"/></Border.Background>
                                        <Border.Effect><DropShadowEffect Color="#E0142A" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
                                    </Border>
                                    <ContentPresenter x:Name="Content" Margin="24,0,6,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl x:Name="SubItems" ItemsSource="{TemplateBinding MenuItems}"
                                              Focusable="False" Visibility="Collapsed"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SelBd" Property="Background" Value="{DynamicResource AkariOverlayFaint}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AkariNavTextActive}"/>
                                </Trigger>
                                <Trigger Property="IsActive" Value="True">
                                    <Setter TargetName="SelBd" Property="Background" Value="{DynamicResource AkariOverlaySoft}"/>
                                    <Setter TargetName="Pill" Property="Opacity" Value="1"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AkariNavTextActive}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="SubItems" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <!-- compact: centre icon, drop pill; children never show at 49px -->
                                <DataTrigger Binding="{Binding Path=(local:Nav.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter TargetName="Content" Property="Margin" Value="0"/>
                                    <Setter TargetName="Content" Property="HorizontalAlignment" Value="Center"/>
                                    <Setter TargetName="SelBd" Property="Margin" Value="6,3"/>
                                    <Setter TargetName="Pill" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="SubItems" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Indented child item (old SubSideBtn look) — Customize's six children. -->
            <Style x:Key="AkariNavSubItem" TargetType="{x:Type ui:NavigationViewItem}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource AkariTextSecondary}"/>
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:NavigationViewItem}">
                            <Grid Background="Transparent" Height="34">
                                <Border x:Name="SelBd" CornerRadius="{StaticResource AkariControlRadius}" Margin="7,1" Background="Transparent" SnapsToDevicePixels="True"/>
                                <Border x:Name="Pill" Width="3" Height="14" CornerRadius="2" Background="#E01424" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0"/>
                                <ContentPresenter Margin="36,0,6,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SelBd" Property="Background" Value="{DynamicResource AkariOverlayFaint}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AkariNavTextActive}"/>
                                </Trigger>
                                <Trigger Property="IsActive" Value="True">
                                    <Setter TargetName="SelBd" Property="Background" Value="{DynamicResource AkariCardBackgroundHover}"/>
                                    <Setter TargetName="Pill" Property="Opacity" Value="1"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AkariNavTextActive}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Collapsible group header (SOFTWARE / OPTIMIZE / ADVANCED).
                 Non-navigating: NavigationView's built-in click behaviour toggles
                 IsExpanded; the chevron animates 90°↔0° and the item panel folds.
                 In compact mode the header swaps for a thin divider and the items
                 always show (icons only). -->
            <Style x:Key="AkariNavGroup" TargetType="{x:Type ui:NavigationViewItem}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource AkariTextMuted}"/>
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:NavigationViewItem}">
                            <StackPanel>
                                <Grid x:Name="HeaderRow" Background="Transparent" Margin="12,11,10,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Chevron" Grid.Column="0" Text="&#xE76C;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                               Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center" Margin="0,0,7,0"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><RotateTransform x:Name="ChevronRot" Angle="90"/></TextBlock.RenderTransform>
                                    </TextBlock>
                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                                <Border x:Name="Divider" Height="1" Margin="12,12,12,6" Background="{DynamicResource AkariHairline}" Visibility="Collapsed"/>
                                <ItemsControl x:Name="SubItems" ItemsSource="{TemplateBinding MenuItems}" Focusable="False"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <!-- Chevron defaults to 90° (expanded); rotate to 0° when collapsed. -->
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="SubItems" Property="Visibility" Value="Collapsed"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChevronRot" Storyboard.TargetProperty="Angle"
                                                                 To="0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChevronRot" Storyboard.TargetProperty="Angle"
                                                                 To="90" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger SourceName="HeaderRow" Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AkariTextSecondary}"/>
                                </Trigger>
                                <Trigger Property="IsActive" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AkariTextSecondary}"/>
                                </Trigger>
                                <!-- compact: header → divider, items always visible (icons only) -->
                                <DataTrigger Binding="{Binding Path=(local:Nav.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Divider" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="SubItems" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
