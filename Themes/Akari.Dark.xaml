<!--
  Akari.Dark.xaml  —  DARK theme token dictionary.
  Holds every per-theme Color + Brush. Swapped wholesale at runtime by
  ThemeService with Akari.Light.xaml (identical key set, different values).
  Merged AFTER ui:ControlsDictionary and BEFORE AkariFluentTheme.xaml so the
  red accent + colour keys win over WPF-UI defaults while the agnostic control
  styles resolve these tokens via {DynamicResource}.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ════════════════ LEGACY PALETTE (retargeted to v3 neutrals) ════════════════ -->
  <Color x:Key="AkariRed">#FFE0142A</Color>
  <Color x:Key="AkariRedHot">#FFFF4150</Color>
  <Color x:Key="AkariRedSoft">#FFFF6373</Color>
  <Color x:Key="AkariBg">#FF0B0B0D</Color>
  <Color x:Key="AkariPanel">#FF121215</Color>
  <Color x:Key="AkariText">#FFF2F2F4</Color>
  <Color x:Key="AkariTextMutedLegacy">#FF9A9AA0</Color>

  <SolidColorBrush x:Key="AkariRedBrush"       Color="{StaticResource AkariRed}"/>
  <SolidColorBrush x:Key="AkariTextBrush"      Color="{StaticResource AkariText}"/>
  <SolidColorBrush x:Key="AkariTextMutedBrush" Color="{StaticResource AkariTextMutedLegacy}"/>

  <!-- ════════════════ V3 DESIGN TOKENS — COLOURS ════════════════ -->
  <Color x:Key="AkariCanvasTop">#202020</Color>
  <Color x:Key="AkariCanvasBottom">#202020</Color>
  <Color x:Key="AkariContentSurfaceColor">#262626</Color>
  <Color x:Key="AkariCardBackgroundColor">#2D2D2D</Color>
  <Color x:Key="AkariCardBackgroundHoverColor">#323232</Color>
  <Color x:Key="AkariSidebarBackgroundColor">#202020</Color>
  <Color x:Key="AkariHairlineColor">#383838</Color>
  <Color x:Key="AkariHairlineHoverColor">#484848</Color>
  <!-- Card elevation stroke stops: lit top (brighter, catches light), shadow bottom
       (recedes toward the canvas). Grey/hairline family, widened for 1px legibility. -->
  <Color x:Key="AkariCardElevationLitColor">#3A3A3A</Color>
  <Color x:Key="AkariCardElevationShadowColor">#242424</Color>
  <Color x:Key="AkariTextPrimaryColor">#FFFFFFFF</Color>
  <Color x:Key="AkariTextSecondaryColor">#FFCCCCCC</Color>
  <Color x:Key="AkariTextMutedColor">#FFA6A6A6</Color>
  <Color x:Key="AkariIconNeutralColor">#FFB3B3B3</Color>
  <Color x:Key="AkariAccentColor">#FFE0142A</Color>
  <Color x:Key="AkariAccentHotColor">#FFFF2438</Color>
  <Color x:Key="AkariLogSurfaceColor">#FF0E0E0E</Color>

  <!-- Semantic colours (dark) -->
  <Color x:Key="AkariSuccessColor">#FF3DDC84</Color>
  <Color x:Key="AkariWarnColor">#FFF5C542</Color>
  <Color x:Key="AkariWinBlueColor">#FF4CC2FF</Color>
  <Color x:Key="StarGold">#FFF5C542</Color>
  <Color x:Key="WinBlue">#FF4CC2FF</Color>

  <!-- Banner / status roles (Fg text, Bg tint, Border) — dark surfaces -->
  <Color x:Key="AkariSuccessFgColor">#FFA6E3A1</Color>
  <Color x:Key="AkariSuccessBgColor">#14A6E3A1</Color>
  <Color x:Key="AkariSuccessBorderColor">#33A6E3A1</Color>
  <Color x:Key="AkariInfoFgColor">#FF4CC2FF</Color>
  <Color x:Key="AkariInfoBgColor">#1A4CC2FF</Color>
  <Color x:Key="AkariInfoBorderColor">#334CC2FF</Color>
  <Color x:Key="AkariWarnFgColor">#FFF5C542</Color>
  <Color x:Key="AkariWarnBgColor">#1AF5C542</Color>
  <Color x:Key="AkariWarnBorderColor">#33F5C542</Color>
  <Color x:Key="AkariDangerFgColor">#FFFF7A88</Color>
  <Color x:Key="AkariDangerBgColor">#B8140A0D</Color>
  <Color x:Key="AkariDangerBorderColor">#33FF3C50</Color>

  <!-- Card-header pill buttons (bulk actions) — neutral + accent sets -->
  <Color x:Key="AkariPillNeutralBgColor">#00000000</Color>
  <Color x:Key="AkariPillNeutralBorderColor">#FF4A4A4A</Color>
  <Color x:Key="AkariPillNeutralFgColor">#FF9A9AA0</Color>
  <Color x:Key="AkariPillAccentBgColor">#00000000</Color>
  <Color x:Key="AkariPillAccentBorderColor">#FFE0142A</Color>
  <Color x:Key="AkariPillAccentFgColor">#FFE0142A</Color>

  <!-- Muted red for body-size text (links, counts, inline emphasis). NOT the brand
       accent: crimson at body size fails AA, these are lightened to clear it. -->
  <Color x:Key="AkariAccentTextColor">#FFFF8A94</Color>
  <Color x:Key="AkariAccentTextMutedColor">#FFE2808A</Color>

  <!-- Icon fills (need less darkening than text to read right) -->
  <Color x:Key="AkariStarGoldColor">#FFF5C542</Color>
  <Color x:Key="AkariWinBlueIconColor">#FF4CC2FF</Color>

  <!-- Per-row badge pill colours (transparent-bg, coloured border + text) -->
  <Color x:Key="AkariPillPreferenceColor">#FFA586D9</Color>
  <Color x:Key="AkariPillRecommendedColor">#FFE0142A</Color>
  <Color x:Key="AkariPillDefaultColor">#73FFFFFF</Color>
  <Color x:Key="AkariPillCustomColor">#59FFFFFF</Color>
  <Color x:Key="AkariPillGenericColor">#FF9AA0A6</Color>

  <!-- ════════════════ V3 DESIGN TOKENS — BRUSHES ════════════════ -->
  <SolidColorBrush x:Key="AkariCanvasTopBrush"      Color="{StaticResource AkariCanvasTop}"/>
  <SolidColorBrush x:Key="AkariCanvasBottomBrush"   Color="{StaticResource AkariCanvasBottom}"/>
  <SolidColorBrush x:Key="AkariContentSurface"      Color="{StaticResource AkariContentSurfaceColor}"/>
  <SolidColorBrush x:Key="AkariCardBackground"      Color="{StaticResource AkariCardBackgroundColor}"/>
  <!-- Gradient elevation stroke for card + frame edges (NOT for dividers/lines).
       Vertical, lit top to shadow bottom; the flat AkariHairline stays for lines. -->
  <LinearGradientBrush x:Key="AkariCardElevationBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{StaticResource AkariCardElevationLitColor}" Offset="0"/>
    <GradientStop Color="{StaticResource AkariCardElevationShadowColor}" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AkariCardBackgroundHover" Color="{StaticResource AkariCardBackgroundHoverColor}"/>
  <SolidColorBrush x:Key="AkariSidebarBackground"   Color="{StaticResource AkariSidebarBackgroundColor}"/>
  <SolidColorBrush x:Key="AkariHairline"            Color="{StaticResource AkariHairlineColor}"/>
  <SolidColorBrush x:Key="AkariHairlineHover"       Color="{StaticResource AkariHairlineHoverColor}"/>
  <SolidColorBrush x:Key="AkariTextPrimary"         Color="{StaticResource AkariTextPrimaryColor}"/>
  <SolidColorBrush x:Key="AkariTextSecondary"       Color="{StaticResource AkariTextSecondaryColor}"/>
  <SolidColorBrush x:Key="AkariTextMuted"           Color="{StaticResource AkariTextMutedColor}"/>
  <SolidColorBrush x:Key="AkariIconNeutral"         Color="{StaticResource AkariIconNeutralColor}"/>
  <SolidColorBrush x:Key="AkariAccent"              Color="{StaticResource AkariAccentColor}"/>
  <SolidColorBrush x:Key="AkariLogSurface"          Color="{StaticResource AkariLogSurfaceColor}"/>
  <SolidColorBrush x:Key="AkariAccentText"          Color="{StaticResource AkariAccentTextColor}"/>
  <SolidColorBrush x:Key="AkariAccentTextMuted"     Color="{StaticResource AkariAccentTextMutedColor}"/>

  <!-- Semantic brushes -->
  <SolidColorBrush x:Key="AkariSuccess"  Color="{StaticResource AkariSuccessColor}"/>
  <SolidColorBrush x:Key="AkariWarn"     Color="{StaticResource AkariWarnColor}"/>
  <SolidColorBrush x:Key="AkariWinBlue"  Color="{StaticResource AkariWinBlueColor}"/>
  <SolidColorBrush x:Key="StarGoldBrush" Color="{StaticResource StarGold}"/>
  <SolidColorBrush x:Key="WinBlueBrush"  Color="{StaticResource WinBlue}"/>

  <!-- ════════════════ OVERLAY WASHES (white-alpha in dark) ════════════════ -->
  <SolidColorBrush x:Key="AkariOverlayFaint"  Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="AkariOverlaySoft"   Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="AkariOverlayMedium" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="AkariOverlayStrong" Color="#1AFFFFFF"/>

  <!-- Nav rail text (idle / active) -->
  <SolidColorBrush x:Key="AkariNavText"       Color="#9EFFFFFF"/>
  <SolidColorBrush x:Key="AkariNavTextActive" Color="#FFFDF2F3"/>

  <!-- The single, always-on window background. Vertical, opaque, no image/glow. -->
  <LinearGradientBrush x:Key="AkariFlatBackdrop" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{StaticResource AkariCanvasTop}" Offset="0"/>
    <GradientStop Color="{StaticResource AkariCanvasBottom}" Offset="1"/>
  </LinearGradientBrush>

  <!-- ════════════════ WPF-UI ACCENT KEYS (same crimson both themes) ════════════════ -->
  <Color x:Key="SystemAccentColor">#FFE0142A</Color>
  <Color x:Key="SystemAccentColorPrimary">#FFE0142A</Color>
  <Color x:Key="SystemAccentColorSecondary">#FFFF2438</Color>
  <Color x:Key="SystemAccentColorTertiary">#FFFF4150</Color>

  <SolidColorBrush x:Key="SystemAccentColorBrush"          Color="#FFE0142A"/>
  <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush"   Color="#FFE0142A"/>
  <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#FFFF2438"/>
  <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush"  Color="#FFFF4150"/>

  <SolidColorBrush x:Key="AccentFillColorDefaultBrush"   Color="#FFE0142A"/>
  <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6E0142A"/>
  <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"  Color="#CCE0142A"/>
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush"   Color="#FF0B0B0D"/>
  <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FF0B0B0D"/>

  <!-- ToggleSwitch on-state (crimson, both themes) -->
  <SolidColorBrush x:Key="ToggleSwitchFillOn"            Color="#FFE0142A"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFFF2438"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"     Color="#FFCC1226"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOn"          Color="#FFE0142A"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FFFF2438"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"   Color="#FFCC1226"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn"        Color="#FFF2F2F4"/>

  <!-- TextBox / search fields — focused accent underline & caret -->
  <SolidColorBrush x:Key="TextControlBorderBrushFocused"     Color="#FFE0142A"/>
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#47E0142A"/>
  <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#66E0142A"/>

  <!-- ════════════════ NAVIGATIONVIEW PANE OVERRIDES ════════════════ -->
  <SolidColorBrush x:Key="NavigationViewContentBackground"                   Color="#00000000"/>
  <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush"              Color="#00000000"/>
  <SolidColorBrush x:Key="NavigationViewItemBackground"                      Color="#00000000"/>
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver"           Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed"               Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected"              Color="#17171B"/>
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedLeftFluent"    Color="#17171B"/>
  <SolidColorBrush x:Key="NavigationViewItemForeground"                      Color="#FFF2F2F4"/>
  <SolidColorBrush x:Key="NavigationViewItemForegroundLeftFluent"            Color="#FFF2F2F4"/>
  <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver"           Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOverLeftFluent" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="NavigationViewItemForegroundPressed"               Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground"             Color="#26262A"/>
  <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground"        Color="#FFE0142A"/>

  <!-- Real shadow for FLOATING surfaces only (popups, flyouts, dialogs). Never on
       cards/rows — WPF DropShadowEffect on many elements causes scroll/resize lag. -->
  <DropShadowEffect x:Key="AkariFloatingShadow" Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.30"/>
  <!-- Card-face shadow (TRIAL: Home + AkariOS only). Higher opacity than light —
       black on a dark canvas has little room to read. Every consumer must also set
       CacheMode=BitmapCache; the WPF effect pipeline is the scroll-latency cost. -->
  <DropShadowEffect x:Key="AkariCardShadow" Color="#000000" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.45"/>
</ResourceDictionary>
