<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AkariTool</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      Unpackaged + self-contained: this machine has no installed Windows App SDK
      runtime, so the runtime ships alongside the EXE (mirrors WinUI.Framework.App).
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    De-elevated asInvoker TEST build isolation (MIGRATION_LOG3 "Phase 6").
    build-deelevated.ps1 passes /p:DeElevatedTest=true; that redirects ONLY the leaf
    IntermediateOutputPath to obj\DeElevated\, so the asInvoker Win32-manifest
    intermediate can never overwrite the normal (requireAdministrator) build's manifest
    in obj\Debug\. BaseIntermediateOutputPath deliberately stays the default obj\ so
    obj\** remains excluded from the default compile globs (redirecting the *base* path
    un-excludes stale obj files and breaks the build). No-op unless DeElevatedTest=true —
    normal builds are byte-for-byte unaffected.
  -->
  <PropertyGroup Condition="'$(DeElevatedTest)' == 'true'">
    <IntermediateOutputPath>obj\DeElevated\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <!-- WMI lookups (GPU list + RAM speed) on the Home system banner. -->
    <PackageReference Include="System.Management" Version="10.0.0" />
    <!-- Service start/stop + status queries (service presets, Competitive Mode,
         ElevationService). net8 build used 8.0.1; bumped to the net10 line. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Phase A development wiring: consume the framework from its source repo so the
      self-contained PriIndexName fix and any framework changes flow into the build.
      Switch to a local NuGet feed (pack WinUI.Framework) before releasing.
    -->
    <ProjectReference Include="vendor\WinUI.Framework\WinUI.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AkariLogo.png" />
    <Content Include="Assets\AkariLogoLight.png" />
    <Content Include="Assets\AkariLogo.ico" />
  </ItemGroup>

  <!-- Embedded payloads the ported LOGIC loads at runtime via GetManifestResourceStream
       (ToolService scripts, DefenderService cab+ps1, NvidiaProfileService .nip). Resource
       names + folder layout match the net8 build so the lookups resolve identically. -->
  <ItemGroup>
    <EmbeddedResource Include="Scripts\*.ps1" />
    <EmbeddedResource Include="Scripts\Network\*.bat" />
    <EmbeddedResource Include="Defender\NoDefender.cab" />
    <EmbeddedResource Include="Defender\DisableDefender.ps1" />
    <EmbeddedResource Include="Nvidia\Settings.nip" Condition="Exists('Nvidia\Settings.nip')" />
  </ItemGroup>
</Project>
