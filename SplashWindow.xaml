<Window x:Class="AkariTool.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Akari Tool"
        Width="1120" Height="748"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{DynamicResource AkariCanvasBottomBrush}">

    <Window.Resources>
        <!-- ══ Motion ══ -->
        <!-- dotPulse: status dot opacity 0.35 → 1 → 0.35, 0.9s, ease-in-out, infinite -->
        <Storyboard x:Key="DotSb" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- fadeUp: content entrance, opacity 0→1 + translateY 14→0, 0.7s, ease-out, once -->
        <Storyboard x:Key="FadeUpSb">
            <DoubleAnimation Storyboard.TargetName="ContentBlock" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContentTranslate" Storyboard.TargetProperty="Y"
                             From="14" To="0" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Flat premium canvas: same vertical gradient as the main window -->
    <Grid ClipToBounds="True" Background="{DynamicResource AkariFlatBackdrop}">

        <!-- Centered brand block (optically above true center) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,96">
            <Image x:Name="LogoImage" Width="180"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Akari Tool" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                       FontSize="30" HorizontalAlignment="Center" Margin="0,24,0,0"
                       Foreground="{DynamicResource AkariTextPrimary}"/>
            <TextBlock Text="System optimization &amp; management utility" FontFamily="{StaticResource BodyFont}"
                       FontSize="13" HorizontalAlignment="Center" Margin="0,9,0,0"
                       Foreground="{DynamicResource AkariTextSecondary}"/>
        </StackPanel>

        <!-- Bottom content block (fadeUp) — centered to match the symmetric layout -->
        <StackPanel x:Name="ContentBlock" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,54" Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="ContentTranslate" Y="14"/>
            </StackPanel.RenderTransform>

            <!-- Progress group -->
            <Grid Width="560" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status row -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{DynamicResource AkariAccent}"/>
                        <TextBlock x:Name="StatusText" Text="Checking administrator privileges" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource MonoFont}" FontSize="13"
                                   Foreground="{DynamicResource AkariTextSecondary}"/>
                    </StackPanel>
                    <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="13"
                               Foreground="{DynamicResource AkariTextMuted}"/>
                </Grid>

                <!-- Segment bar (7 pips) -->
                <Grid x:Name="PipRow" Grid.Row="1" Margin="0,14,0,0" Height="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="4" CornerRadius="3" Background="{DynamicResource AkariHairline}" Margin="0,0,3,0"/>
                    <Border Grid.Column="1" Height="4" CornerRadius="3" Background="{DynamicResource AkariHairline}" Margin="3,0,3,0"/>
                    <Border Grid.Column="2" Height="4" CornerRadius="3" Background="{DynamicResource AkariHairline}" Margin="3,0,3,0"/>
                    <Border Grid.Column="3" Height="4" CornerRadius="3" Background="{DynamicResource AkariHairline}" Margin="3,0,3,0"/>
                    <Border Grid.Column="4" Height="4" CornerRadius="3" Background="{DynamicResource AkariHairline}" Margin="3,0,3,0"/>
                    <Border Grid.Column="5" Height="4" CornerRadius="3" Background="{DynamicResource AkariHairline}" Margin="3,0,3,0"/>
                    <Border Grid.Column="6" Height="4" CornerRadius="3" Background="{DynamicResource AkariHairline}" Margin="3,0,0,0"/>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
