<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AkariTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Akari Tool">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (draggable): logo + accent dot + wordmark. -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="14,0,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image
                    x:Name="TitleLogo"
                    Height="24"
                    Stretch="Uniform"
                    VerticalAlignment="Center"
                    Margin="0,0,9,0" />
                <Ellipse
                    x:Name="TitleDot"
                    Width="5"
                    Height="5"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock
                    FontFamily="Consolas"
                    FontSize="10.5"
                    FontWeight="Bold"
                    VerticalAlignment="Center">
                    <Run Text="AKARI " Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Run Text="TOOL" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Body: nav rail + content -->
        <muxc:NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            SelectionChanged="Nav_SelectionChanged">

            <!-- Global search: queries TweakRegistry across all 7 tweak tabs; picking a
                 result navigates to its tab and pre-fills that page's own search box. -->
            <muxc:NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="GlobalSearch"
                    PlaceholderText="Search all settings…"
                    QueryIcon="Find"
                    TextMemberPath="Display"
                    TextChanged="GlobalSearch_TextChanged"
                    QuerySubmitted="GlobalSearch_QuerySubmitted">
                    <!-- ItemTemplate is required: without it the dropdown renders each
                         item via ToString() (the record's "SearchResult { Display = … }").
                         TextMemberPath only fills the text box after a pick, not the list. -->
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </muxc:NavigationView.AutoSuggestBox>

            <!-- Rail tags MUST match the routing contract (see MainWindow.xaml.cs).
                 Phase A: Home routes to HomePage, every other tag to PlaceholderPage. -->
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Home" Tag="Home">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="SOFTWARE" />
                <muxc:NavigationViewItem Content="Windows Apps" Tag="Bloatware">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="External Apps" Tag="AppInstaller">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Debloat" Tag="Debloat">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="OPTIMIZE" />
                <muxc:NavigationViewItem Content="AkariOS" Tag="AkariOS">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Gaming &amp; Performance" Tag="Gaming">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Privacy &amp; Security" Tag="Privacy">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Windows Updates" Tag="Update">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Notifications" Tag="Notifications">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7E7;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Sound" Tag="Sound">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE767;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Power" Tag="Power">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Customize" Tag="Customize">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </muxc:NavigationViewItem.Icon>
                    <muxc:NavigationViewItem.MenuItems>
                        <muxc:NavigationViewItem Content="Taskbar" Tag="Taskbar" />
                        <muxc:NavigationViewItem Content="Explorer" Tag="Explorer" />
                        <muxc:NavigationViewItem Content="Context Menu" Tag="ContextMenu" />
                        <muxc:NavigationViewItem Content="Appearance" Tag="Appearance" />
                        <muxc:NavigationViewItem Content="Start Menu" Tag="StartMenu" />
                        <muxc:NavigationViewItem Content="Desktop" Tag="Desktop" />
                    </muxc:NavigationViewItem.MenuItems>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Tools" Tag="Tools">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="ADVANCED" />
                <muxc:NavigationViewItem Content="Advanced Tools" Tag="Advanced">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC7A;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Backup &amp; Restore" Tag="Backup">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE777;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Verify" Tag="Verify">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE73E;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="Settings" Tag="Settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <!-- Page host + docked live log console. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Frame x:Name="ContentFrame" Grid.Row="0" />

                <Border
                    x:Name="TxtLogPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,8,16,10">
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="LOG"
                                FontFamily="Consolas"
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="2"
                                x:Name="InfoDialogBtn"
                                Click="InfoDialog_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,2"
                                ToolTipService.ToolTip="About Akari Tool">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE946;"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </Grid>
                        <TextBox
                            x:Name="TxtLog"
                            IsReadOnly="True"
                            IsSpellCheckEnabled="False"
                            Height="86"
                            FontFamily="Consolas"
                            FontSize="11.5"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            Background="Transparent"
                            BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Grid>
        </muxc:NavigationView>

        <!-- Status bar: ready state + theme toggle + LOG toggle + build stamp. -->
        <Border
            Grid.Row="2"
            Background="Transparent"
            BorderThickness="0"
            Padding="16,5,16,5">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse
                        x:Name="StatusDot"
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Margin="0,0,7,0"
                        Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock
                        x:Name="StatusText"
                        Text="Ready"
                        FontSize="11.5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <!-- Driven by ToolService.ProgressStarted / ProgressStopped. -->
                    <ProgressBar
                        x:Name="StatusProgress"
                        Width="120"
                        Height="2"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="14">
                    <!-- Theme toggle: sun glyph while dark, moon glyph while light
                         (icon set in code). -->
                    <Button
                        x:Name="ThemeToggleBtn"
                        Click="ThemeToggle_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Toggle light / dark theme">
                        <FontIcon
                            x:Name="ThemeToggleIcon"
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE706;"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                    <!-- Show / hide the log console. -->
                    <Button
                        x:Name="LogToggleBtn"
                        Click="LogToggle_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Show or hide the log">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon
                                x:Name="LogToggleIcon"
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE70E;"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Text="LOG"
                                FontFamily="Consolas"
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="BuildStamp"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="10.5"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
