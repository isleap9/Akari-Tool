<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ═══════════════════════════════════════════════════════════════════════════════
    SPIKE-02 THROWAWAY PROJECT — THIS FILE IS DELETED IN TASK 3 AND ITS COMMENTS
    ARE THE ONLY RECORD THAT SURVIVES THE DELETION. (D-05, D-07)
    ═══════════════════════════════════════════════════════════════════════════════

    Purpose: answer one question — do Winhance's SettingsCard, DataGrid and
    WrapPanel resolve and RENDER under WindowsAppSDK 2.3.1 with CommunityToolkit.WinUI,
    or must Phases 4 / 5 / 9 plan against substitutes? D-06 sets the bar at
    compile + launch + visually render; a compile-only pass is explicitly insufficient.

    Why it is throwaway and NOT inside src/AkariTool.App (D-05):
      A failing or version-skewed package set inside the app project breaks the
      ENTIRE shipping build until it is reverted, and it would move the Phase 1
      recorded warning/error baseline that plan 01-02 captured in tools/baseline.json.
      A permanent control-compat canary page would silently re-open this question
      on every future package bump. This directory exists, answers the question, and
      is removed — the four pinned packages' build/buildTransitive .props/.targets
      import surface leaves the repository with it.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AkariTool.Spike.WinUiControlCompat</RootNamespace>
    <AssemblyName>WinUiControlCompat</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!--
      EnableMsixTooling is deliberately FALSE (the app project sets it true).
      Microsoft.WinUI.AppX.targets:36 documents that MSIX tooling on library output
      "can erroneously raise a warning thinking that we've packaged multiple
      executables" — a warning the spike's own log would then carry for no reason.
    -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!--
      WindowsAppSDKSelfContained is DELIBERATELY NOT SET HERE. It is passed as a
      /p: global property at build time, and only for THIS project.

      Why: Microsoft.WindowsAppSDK.Base.targets:19-20 hard-errors with
      "WindowsAppSDKSelfContained should not be applied to a class library."
      Global properties flow into every ProjectReference, so passing this flag to
      AkariTool.sln fails all five of its libraries. This spike is a WinExe with
      ZERO ProjectReferences, so the flag can never reach a class library and is
      therefore safe here — and safe ONLY here.
    -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    ApplicationManifest / ApplicationIcon / Version are deliberately OMITTED. The
    spike is not the app: it carries no requireAdministrator manifest, so it runs
    unelevated with the developer's normal token and has no registry-write or SYSTEM
    capability. Accepted (threat T-01-07): a render probe needs none, and running
    unelevated is strictly safer than granting it elevation.
  -->

  <ItemGroup>
    <!--
      KEEP THE METAPACKAGE. Microsoft.WindowsAppSDK.WinUI (the COMPONENT package) must
      NEVER be referenced directly from here or from any other csproj: the 2.3.1
      metapackage's own transitive graph already contains Microsoft.WindowsAppSDK.WinUI,
      so a direct component reference is exactly the dual-family condition that fails
      the build with MSB4011 (duplicate Windows App SDK build props). Matches
      src/AkariTool.App/AkariTool.App.csproj:55 — the shipping app's package list is
      byte-for-byte unchanged by this spike's existence.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />

    <!--
      EXPLICIT, NOT TRANSITIVE: Microsoft.Windows.CsWinRT is NOT a nuspec dependency of
      ANY CommunityToolkit.WinUI 8.2 package (verified from the flatcontainer .nuspec
      files). NuGet will not rescue it — WCT 8.2's WinRT content simply will not project
      without this reference.
    -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />

    <!-- SettingsCard. Pinned to the 8.2 train, never the 8.3 preview train: 8.3
         switched its WindowsAppSDK dependency from the metapackage to the COMPONENT
         package, which is the MSB4011 trap named above. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />

    <!-- WrapPanel. Same 8.2 train, same reason. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />

    <!--
      DataGrid — FROZEN AT 7.1.2. Last published 2021-11-18; six versions have ever
      existed. The CommunityToolkit.WinUI metapackage id itself also stops at 7.1.2, so
      this is the ONLY DataGrid available at any version. It is therefore an ACCEPTED,
      UNDERSTOOD unmaintained dependency — recorded in the verdict as such, not an
      oversight. Its only nuspec dependency is Microsoft.WindowsAppSDK 1.0.0 (a minimum,
      cleared by 2.3.1) and it has no CommunityToolkit.* coupling at all, so it is the
      lowest-risk of the three packages, not the highest.
    -->
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />
  </ItemGroup>

  <!--
    DELIBERATELY NOT REFERENCED:
      Microsoft.WindowsAppSDK.WinUI        — component package; MSB4011 dual-family hazard.
      CommunityToolkit.WinUI (metapackage) — tops out at 7.1.2, so an 8.x ref fails restore;
                                            that is why the 8.x train is referenced PER PACKAGE.
      CommunityToolkit.WinUI.* 8.3 previews — depend on the component package. Same hazard.
      Microsoft.Windows.SDK.BuildTools     — already resolved transitively at
                                            10.0.26100.4654; latest published is
                                            10.0.28000.2705, so an explicit or floating
                                            reference would silently UPGRADE the SDK
                                            toolchain and move the Phase 1 build baseline.
      CommunityToolkit.WinUI.Behaviors     — drags in Microsoft.Xaml.Behaviors.WinUI.Managed
                                            for zero benefit against these three controls.
      CommunityToolkit.WinUI.Collections   — not needed by these three controls.
  -->

  <!--
    ZERO ProjectReference's, and that is load-bearing rather than an omission.
    A reference to AkariTool.App would drag in three variables this clean-room probe
    does not need and cannot afford: the self-contained win-x64 App graph,
    Material.Icons.WinUI3's Microsoft.Windows.CsWinRT 2.1.1 floor, and
    vendor/WinUI.Framework. Any of them could resolve a type this spike is supposed to
    be testing, which would make the finding unfalsifiable. This project also is NOT a
    member of AkariTool.sln, so a solution build can never reach it.
  -->

</Project>
