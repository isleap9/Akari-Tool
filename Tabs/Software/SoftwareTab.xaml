<?xml version="1.0" encoding="utf-8"?>
<!--
  MIGRATION (WinUI 3): the WPF version of this file carried ~280 lines of
  ControlTemplate/Trigger retemplates (DlCheckBox, DlListViewItem, DlSearchBox,
  DlFilterBtn, DlActionBtn, DlCancelBtn) purely to suppress the system highlight
  and paint Akari chrome. WinUI has no trigger system, and per the migration
  brief these are rebuilt with native controls + theme-resource overrides rather
  than ported. Only DlActionBtn/DlCancelBtn were referenced from C#
  (SoftwareTab.UiHelpers.MakeActionButton) and now map to native button chrome.
  The body was always just RootPanel.
-->
<local:BaseTab
    x:Class="AkariTool.Tabs.SoftwareTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AkariTool.Tabs">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <StackPanel x:Name="RootPanel" MaxWidth="1000"/>
    </ScrollViewer>
</local:BaseTab>
