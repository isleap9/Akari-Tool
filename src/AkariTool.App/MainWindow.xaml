<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AkariTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:AkariTool.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Akari Tool">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (draggable): logo + accent dot + wordmark. -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="14,0,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Vector logo (traced from the source artwork): resolution-independent,
                     so it's pixel-crisp at any size/DPI with no raster scaling involved.
                     Fills are ThemeResource brushes, so light/dark switching is automatic —
                     no code-behind bitmap swap needed any more.
                     Height=15: the trimmed source art has ~0% padding now (unlike the old
                     PNG, where the visible mark was only ~50% of a 24px box), so this needs
                     to be sized much smaller than the old Image's Height to land on the same
                     apparent size — measured against the original screenshots (~10px visible
                     glyph) with a little headroom since it no longer needs padding to survive
                     downscaling. -->
                <Viewbox
                    Height="15"
                    Stretch="Uniform"
                    VerticalAlignment="Center"
                    Margin="0,-10,7,0">
                    <Canvas Width="634" Height="639">
                        <Path
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                            Data="M 402.933333333,90.2666666666 c -8.13333333333,16.8 -29.3333333333,59.7333333333 -47.0666666667,95.7333333333 c -35.3333333333,71.8666666666 -61.3333333333,124.533333333 -81.2,165.333333333 c -7.2,14.6666666667 -20.9333333333,42.8 -30.6666666667,62.6666666667 c -28,57.0666666667 -48.6666666667,99.3333333333 -62,126.666666667 c -6.8,13.8666666667 -29.8666666667,61.0666666667 -51.3333333333,104.666666667 c -21.4666666667,43.6 -46.4,94.5333333333 -55.4666666667,113.066666667 l -16.4,33.6 l 57.6,0 l 57.6,0 l 32.6666666667,-67.0666666666 c 17.8666666667,-36.8 74,-149.866666667 124.666666667,-251.2 l 92,-184.4 l 41.7333333333,83.0666666666 c 77.4666666666,154.266666667 83.0666666666,165.2 84.9333333333,164.4 c 0.933333333333,-0.266666666667 7.6,-5.06666666667 14.9333333333,-10.4 c 7.2,-5.46666666667 24.6666666667,-18.5333333333 38.6666666667,-29.0666666667 l 25.7333333333,-19.0666666667 l -64.1333333333,-127.466666667 c -108.533333333,-215.466666667 -145.6,-288.8 -146.533333333,-289.866666667 c -0.4,-0.533333333333 -7.46666666666,12.6666666667 -15.7333333333,29.3333333333 z" />
                        <Path
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            Data="M 630.666666667,540.266666667 c -43.8666666667,33.7333333333 -118.933333333,92.1333333333 -146.533333333,113.733333333 c -15.8666666667,12.5333333333 -46.5333333333,36.5333333333 -68.1333333333,53.4666666667 c -79.2,61.8666666667 -102.533333333,80.1333333333 -105.866666667,83.3333333333 c -0.8,0.666666666667 23.8666666667,1.2 58.6666666667,1.2 l 60,0 l 18.5333333333,-14.2666666667 c 10.2666666667,-7.73333333333 44.1333333333,-33.3333333333 75.3333333333,-56.9333333333 c 31.2,-23.4666666667 62.9333333333,-47.4666666667 70.6666666666,-53.4666666667 c 7.73333333333,-5.86666666667 14.6666666667,-11.2 15.4666666667,-11.7333333333 c 1.46666666667,-0.8 14.8,24.1333333333 60.8,113.333333333 l 11.8666666667,23.0666666667 l 52.6666666667,0 c 29.0666666667,0 52.5333333333,-0.533333333333 52.2666666667,-1.06666666667 c -2.4,-5.86666666667 -131.733333333,-261.6 -133.6,-264.4 c -1.33333333333,-1.86666666667 -4.26666666667,-0.133333333333 -22.1333333333,13.7333333333 z" />
                    </Canvas>
                </Viewbox>
                <Ellipse
                    x:Name="TitleDot"
                    Width="5"
                    Height="5"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock
                    FontFamily="Consolas"
                    FontSize="10.5"
                    FontWeight="Bold"
                    VerticalAlignment="Center">
                    <Run Text="AKARI " Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Run Text="TOOL" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Body: nav rail + content -->
        <muxc:NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            SelectionChanged="Nav_SelectionChanged">

            <!-- Global search: queries TweakRegistry across all 7 tweak tabs; picking a
                 result navigates to its tab and pre-fills that page's own search box. -->
            <muxc:NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="GlobalSearch"
                    PlaceholderText="Search all settings…"
                    QueryIcon="Find"
                    TextMemberPath="Display"
                    TextChanged="GlobalSearch_TextChanged"
                    QuerySubmitted="GlobalSearch_QuerySubmitted">
                    <!-- ItemTemplate is required: without it the dropdown renders each
                         item via ToString() (the record's "SearchResult { Display = … }").
                         TextMemberPath only fills the text box after a pick, not the list. -->
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </muxc:NavigationView.AutoSuggestBox>

            <!-- Rail tags MUST match the routing contract (see MainWindow.xaml.cs).
                 Phase A: Home routes to HomePage, every other tag to PlaceholderPage. -->
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Home" Tag="Home">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="SOFTWARE" />
                <muxc:NavigationViewItem Content="Windows Apps" Tag="Bloatware">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="External Apps" Tag="AppInstaller">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Debloat" Tag="Debloat">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="OPTIMIZE" />
                <!-- Optimize is now a hub (OptimizeHubPage): AkariOS is a pinned card and
                     Gaming/Privacy/Update/Notifications/Sound/Power drill in via the hub's
                     inner frame. The old flat entries collapsed into this single rail item. -->
                <muxc:NavigationViewItem Content="Optimize" Tag="Optimize">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <!-- Single flat entry (like Advanced Tools): no children, no chevron.
                     Category selection happens in the content area — CustomizePage is a
                     card hub that navigates the content Frame to the 6 category pages. -->
                <muxc:NavigationViewItem Content="Customize" Tag="Customize">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Tools" Tag="Tools">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="ADVANCED" />
                <muxc:NavigationViewItem Content="Advanced Tools" Tag="Advanced">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC7A;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Backup &amp; Restore" Tag="Backup">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE777;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Verify" Tag="Verify">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE73E;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="Settings" Tag="Settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <!-- Page host + docked live log console. -->
            <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                <!-- Drift notification: lives inside the content area (above the page
                     Frame, right of the nav rail). Hidden until the post-warm-up drift
                     scan finds tweaks Windows silently reverted to their factory
                     defaults. "Review" jumps to the Verify page. -->
                <muxc:InfoBar
                    x:Name="DriftBanner"
                    Grid.Row="0"
                    IsOpen="False"
                    Severity="Warning"
                    Title="Settings reverted"
                    Margin="12,12,12,0">
                    <muxc:InfoBar.ActionButton>
                        <Button Content="Review" Click="DriftBanner_Review_Click" />
                    </muxc:InfoBar.ActionButton>
                </muxc:InfoBar>

                <Frame x:Name="ContentFrame" Grid.Row="1" />

                <!-- Task progress card (4f, Winhance TaskProgressControl parity) -->
                <StackPanel Grid.Row="2" Margin="0,4,12,4" Spacing="4">
                    <controls:TaskProgressControl x:Name="TaskProgressCard" />
                </StackPanel>

                <Border
                    x:Name="TxtLogPanel"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,8,16,10">
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="LOG"
                                FontFamily="Consolas"
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="2"
                                x:Name="InfoDialogBtn"
                                Click="InfoDialog_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,2"
                                ToolTipService.ToolTip="About Akari Tool">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE946;"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </Grid>
                        <TextBox
                            x:Name="TxtLog"
                            IsReadOnly="True"
                            IsSpellCheckEnabled="False"
                            Height="86"
                            FontFamily="Consolas"
                            FontSize="11.5"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            Background="Transparent"
                            BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Grid>
        </muxc:NavigationView>

        <!-- Status bar: ready state + theme toggle + LOG toggle + build stamp. -->
        <Border
            Grid.Row="2"
            Background="Transparent"
            BorderThickness="0"
            Padding="16,5,16,5">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse
                        x:Name="StatusDot"
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Margin="0,0,7,0"
                        Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock
                        x:Name="StatusText"
                        Text="Ready"
                        FontSize="11.5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <!-- Driven by ToolService.ProgressStarted / ProgressStopped. -->
                    <ProgressBar
                        x:Name="StatusProgress"
                        Width="120"
                        Height="2"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="14">
                    <!-- Theme toggle: sun glyph while dark, moon glyph while light
                         (icon set in code). -->
                    <Button
                        x:Name="ThemeToggleBtn"
                        Click="ThemeToggle_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Toggle light / dark theme">
                        <FontIcon
                            x:Name="ThemeToggleIcon"
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE706;"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                    <!-- Show / hide the log console. -->
                    <Button
                        x:Name="LogToggleBtn"
                        Click="LogToggle_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Show or hide the log">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon
                                x:Name="LogToggleIcon"
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE70E;"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Text="LOG"
                                FontFamily="Consolas"
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="BuildStamp"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="10.5"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
