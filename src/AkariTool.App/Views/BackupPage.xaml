<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup & Restore (rail tag "Backup") — MVVM port of net8 Tabs/Backup/BackupTab.
    Two static cards (Export / Import) over the already-ported, format-identical
    TweakRegistry engine. NOT a tweak page — registers nothing, [WARMUP] stays 439.

    The import review dialog (with the Defender callout, isleap Option 2) is built in
    code — ViewModels/Backup/ImportReviewDialog.cs — not here.
-->
<Page
    x:Class="AkariTool.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" MaxWidth="900" HorizontalAlignment="Center">
            <!-- Header/breadcrumb are provided by the Advanced Tools hub; this page is bare. -->

            <!-- ── Export card ─────────────────────────────────────────────── -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,16,20,16"
                Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <FontIcon
                            Glyph="&#xE898;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ExportCardTitle}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.ExportCardDescription}"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,12" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,0,0,12" />
                    <Button
                        Content="Export to File…"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.ExportCommand}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ExportStatus, Mode=OneWay}"
                        Foreground="{x:Bind ViewModel.ExportStatusBrush, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ExportStatusVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        FontSize="12"
                        FontFamily="Consolas"
                        TextWrapping="Wrap"
                        Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- ── Import card ─────────────────────────────────────────────── -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,16,20,16"
                Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <FontIcon
                            Glyph="&#xE8B5;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ImportCardTitle}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.ImportCardDescription}"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,12" />
                    <Button
                        Content="Import from File…"
                        HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.ImportCommand}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ImportStatus, Mode=OneWay}"
                        Foreground="{x:Bind ViewModel.ImportStatusBrush, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ImportStatusVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        FontSize="12"
                        FontFamily="Consolas"
                        TextWrapping="Wrap"
                        Margin="0,10,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
