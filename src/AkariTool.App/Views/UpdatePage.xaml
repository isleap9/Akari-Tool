<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AkariTool.Views.UpdatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <!-- Bare detail page: hosted inside the Optimize hub's inner frame, which owns the
         header, search and Quick Actions. This page renders only its section rows. -->
    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" MaxWidth="1100" HorizontalAlignment="Center">
            <ItemsControl
                ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}"
                ItemTemplate="{StaticResource TweakSectionTemplate}" />
        </StackPanel>
    </ScrollViewer>
</Page>
