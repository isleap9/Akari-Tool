<?xml version="1.0" encoding="utf-8"?>
<!--
    Home (rail tag "Home") — Phase 9 real port replacing the Phase-A demo stub.
    System-info banner (bound to the trimmed HomeViewModel) + a global search wired to
    TweakRegistry.Search + a quick-nav card grid, both built in the code-behind. NOT a
    tweak page — registers nothing.
-->
<Page
    x:Class="AkariTool.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <!-- Matches the hub chrome: a big header (icon + title + description) on the flattened
         background, with the page content in the same rounded neutral panel the hubs use. -->
    <Grid Padding="28,0,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header -->
            <RowDefinition Height="*" />     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,24,0,16">
            <Viewbox Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center">
                <TextBlock
                    Text="&#xE80F;"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Viewbox>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Margin="0,2,0,0"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <!-- Content panel -->
        <Border Grid.Row="1"
                Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                CornerRadius="8"
                Margin="0,0,0,12">
            <ScrollViewer>
                <StackPanel Padding="24,20,24,24" MaxWidth="1000" HorizontalAlignment="Center">

            <!-- System information banner (restored old layout: big edition/version
                 header over a 3-column Processor/Graphics/Memory stat row, in place
                 of the newly-ported label-value grid — same ViewModel bindings,
                 different presentation only). -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,16,20,16"
                Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.Edition, Mode=OneWay}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Version, Mode=OneWay}"
                        FontSize="12.5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,2,0,0" />

                    <Border
                        Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="0,14,0,14" />

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock
                                Text="PROCESSOR"
                                FontFamily="Consolas"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Cpu, Mode=OneWay}"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                TextWrapping="Wrap"
                                Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Text="GRAPHICS"
                                FontFamily="Consolas"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Gpu, Mode=OneWay}"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                TextWrapping="Wrap"
                                Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Text="MEMORY"
                                FontFamily="Consolas"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Memory, Mode=OneWay}"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                TextWrapping="Wrap"
                                Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Global search across every tab (TweakRegistry.Search) -->
            <AutoSuggestBox
                x:Name="SearchBox"
                PlaceholderText="Search all tweaks across every tab…"
                QueryIcon="Find"
                FontSize="14"
                Height="44"
                Margin="0,0,0,16"
                TextChanged="SearchBox_TextChanged"
                AutomationProperties.Name="Search all tweaks" />

            <!-- Search results (code-filled; shown while searching) -->
            <Border
                x:Name="ResultsCard"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18,10,18,10"
                Visibility="Collapsed">
                <StackPanel x:Name="ResultsPanel" />
            </Border>

            <!-- Quick-nav card grid (code-filled; shown when not searching) -->
            <StackPanel x:Name="CardsPanel" />

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
