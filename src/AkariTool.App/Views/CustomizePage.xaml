<?xml version="1.0" encoding="utf-8"?>
<!--
    Customize hub (rail tag "Customize"). Hosts the shared HubView chrome and supplies its
    overview cards. Taskbar / Explorer / Appearance / Start Menu / Desktop drill into their
    (bare) detail pages inside the HubView inner frame; card pills bind to each page's
    SettingPageViewModel counts. Replaces the old code-filled card grid.
-->
<Page
    x:Class="AkariTool.Views.CustomizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AkariTool.Views.Controls"
    NavigationCacheMode="Required">

    <controls:HubView x:Name="Hub" />
</Page>
