<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AkariTool.Views.Controls.HubView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AkariTool.Views.Controls"
    xmlns:vm="using:AkariTool.ViewModels.Common">

    <!-- Uniform left/right inset for the whole hub so header, nav row and content panel
         share one flush left edge (Winhance layout). -->
    <Grid Padding="28,0,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header -->
            <RowDefinition Height="Auto" />  <!-- Nav row -->
            <RowDefinition Height="*" />     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Row 0: header (icon + title + description on the left, search on the right). -->
        <Grid Grid.Row="0" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                <Viewbox Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="HeaderIcon"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Viewbox>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="HeaderTitleText"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock
                        x:Name="HeaderDescriptionText"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Margin="0,2,0,0"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="1"
                Width="220"
                VerticalAlignment="Bottom"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged"
                QuerySubmitted="SearchBox_QuerySubmitted" />
        </Grid>

        <!-- Row 1: breadcrumb (left) + Quick Actions + View (right). -->
        <Grid Grid.Row="1" Margin="0,12,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                <!-- Root button → overview. -->
                <Button x:Name="BreadcrumbRoot" Click="BreadcrumbRoot_Click" Padding="8,4"
                        Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="BreadcrumbRootIcon"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="BreadcrumbRootText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Separator + current-section dropdown (detail pages only). -->
                <TextBlock x:Name="BreadcrumbSeparator"
                           Text="&#xE76C;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />

                <DropDownButton x:Name="BreadcrumbSection" Visibility="Collapsed" Padding="8,4">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="BreadcrumbSectionIcon"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="BreadcrumbSectionText" VerticalAlignment="Center" />
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <ItemsControl x:Name="BreadcrumbFlyoutItems" MinWidth="180">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HubCardViewModel">
                                        <Button Click="SectionFlyoutItem_Click"
                                                Tag="{x:Bind}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent" BorderThickness="0" Padding="8,5">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Glyph}"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="15" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <!-- Quick Actions (old rich look: each action shows its live pending count).
                 Subtitles are filled on flyout open from the current detail page's VM. -->
            <Button x:Name="QuickActionsButton" Grid.Column="1" VerticalAlignment="Center"
                    Margin="0,0,4,0" Padding="12,7,10,7" CornerRadius="8"
                    AutomationProperties.Name="Quick actions"
                    ToolTipService.ToolTip="Bulk actions for every setting on this page">
                <StackPanel Orientation="Horizontal">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="12"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="Quick actions" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="10"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Margin="7,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="QuickActionsFlyout" Opening="QuickActionsFlyout_Opening">
                        <StackPanel MinWidth="280">

                            <Button Click="ApplyRecommended_Click" Background="Transparent" BorderThickness="0"
                                    Padding="6,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE735;" FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Margin="2,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="Apply all recommended" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock x:Name="RecommendedSubtitleText" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Click="ResetDefaults_Click" Background="Transparent" BorderThickness="0"
                                    Padding="6,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE777;" FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Margin="2,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="Restore Windows defaults" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DefaultSubtitleText" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4" />

                            <Button Click="CreateRestorePoint_Click" Background="Transparent" BorderThickness="0"
                                    Padding="6,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7B8;" FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Margin="2,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="Create restore point" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="System snapshot before you change anything" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- View menu. -->
            <DropDownButton x:Name="ViewMenuButton" Grid.Column="2" VerticalAlignment="Center">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                        <TextBlock Text="View" VerticalAlignment="Center" />
                    </StackPanel>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <ToggleMenuFlyoutItem x:Name="TechnicalDetailsToggleItem" Text="Technical Details" Click="ViewToggle_Click">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="InfoBadgesToggleItem" Text="Info Badges" Click="ViewToggle_Click">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- Row 2: content border (rounded, neutral) — overview cards OR inner frame. -->
        <Border Grid.Row="2"
                Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                CornerRadius="8"
                Margin="0,0,0,12">
            <Grid>
                <!-- Overview cards. -->
                <ScrollViewer x:Name="OverviewScroll">
                    <ItemsControl x:Name="CardItems" Padding="16,16,16,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HubCardViewModel">
                                <Button Click="Card_Click"
                                        Tag="{x:Bind}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,8"
                                        Padding="14,12,14,12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid ColumnSpacing="13" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon tile. -->
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Glyph}"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Title + description. -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Description}" FontSize="11.5"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Aggregate pills. -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center" Margin="8,0,8,0">
                                            <Border Visibility="{x:Bind RecommendedPillVisibility, Mode=OneWay}"
                                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    CornerRadius="10" Padding="8,3">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE735;" FontSize="11" VerticalAlignment="Center"
                                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                    <TextBlock Text="{x:Bind RecommendedPillText, Mode=OneWay}" FontSize="11"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Visibility="{x:Bind DefaultPillVisibility, Mode=OneWay}"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="10" Padding="8,3">
                                                <TextBlock Text="{x:Bind DefaultPillText, Mode=OneWay}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Chevron. -->
                                        <TextBlock Grid.Column="3" Text="&#xE76C;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Detail page frame (visible on drill-in). -->
                <Frame x:Name="DetailFrame" Visibility="Collapsed" Navigated="DetailFrame_Navigated" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
