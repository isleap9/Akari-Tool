<?xml version="1.0" encoding="utf-8"?>
<!--
    Power Plan dropdown. Ported 1:1 from Winhance's PowerPlanComboBox control,
    adapted to Akari conventions:
      • Items are Akari's Core PowerPlanComboBoxOption model (not Winhance's
        ComboBoxDisplayOption wrapper), bound directly.
      • Selection commits on DropDownClosed (Winhance timing), not on every
        selection change — keyboard-navigating the open dropdown must NOT switch
        the active power plan repeatedly.
      • Delete is a DeleteCommand DP instead of Winhance's DeleteRequested event.
      • Literal English tooltips; a FontIcon trash glyph instead of the Winhance
        icon-resource PathIcon (Akari drops icon dictionaries).

    Visual states (green/red status dot, [Active] badge, trash visibility) are
    applied in code-behind when the dropdown opens, because ComboBox item
    containers are only realized while the dropdown is open.
-->
<UserControl
    x:Class="AkariTool.Views.Controls.PowerPlanComboBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ComboBox
        x:Name="PowerPlanSelector"
        MinWidth="220"
        MaxDropDownHeight="300"
        ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
        SelectedIndex="{x:Bind SelectedIndex, Mode=OneWay}"
        DropDownOpened="OnDropDownOpened"
        DropDownClosed="OnDropDownClosed">

        <ComboBox.ItemTemplate>
            <!-- {Binding} (not x:Bind): PowerPlanComboBoxOption's props are init-only,
                 which the XAML type-info generator cannot instance-create. -->
            <DataTemplate>
                <Grid x:Name="ItemRoot" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status dot: green = installed on system, red = not installed -->
                    <Ellipse
                        x:Name="StatusIndicator"
                        Grid.Column="0"
                        Width="8" Height="8"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>

                    <!-- Display name + [Active] badge -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                        <TextBlock
                            x:Name="ActiveBadge"
                            Text="[Active]"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Delete (installed + not active only) -->
                    <Button
                        x:Name="DeleteButton"
                        Grid.Column="2"
                        Width="20" Height="20" MinWidth="20" MinHeight="20"
                        Padding="0" Margin="4,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Delete this power plan">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver">#C42B1C</SolidColorBrush>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed">#B22A1C</SolidColorBrush>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver">White</SolidColorBrush>
                            <SolidColorBrush x:Key="ButtonForegroundPressed">White</SolidColorBrush>
                        </Button.Resources>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE74D;"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Button>
                </Grid>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>