<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AkariTool.Views.Controls.NavSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AkariTool.Views.Controls"
    AutomationProperties.LandmarkType="Navigation">

    <Grid Width="{x:Bind ActualSidebarWidth, Mode=OneWay}" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Hamburger toggle -->
            <RowDefinition Height="Auto" /> <!-- Top nav -->
            <RowDefinition Height="*" />    <!-- Spacer -->
            <RowDefinition Height="Auto" /> <!-- Bottom nav -->
        </Grid.RowDefinitions>

        <!-- Collapse / expand toggle -->
        <Button x:Name="ToggleButton"
                Grid.Row="0"
                HorizontalAlignment="Center"
                Margin="0,8,0,4"
                Width="40" Height="36"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="ToggleButton_Click"
                AutomationProperties.Name="Toggle navigation pane"
                ToolTipService.ToolTip="Toggle navigation pane">
            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE700;" FontSize="15" />
        </Button>

        <!-- Top navigation group -->
        <StackPanel x:Name="TopNavPanel" Grid.Row="1" Spacing="4" HorizontalAlignment="Center" Margin="0,4,0,0">
            <local:NavButton x:Name="HomeButton"      IconSymbol="Home"              Text="Home"           NavigationTag="Home"        IsCompact="{x:Bind IsCompact, Mode=OneWay}" Clicked="NavButton_Clicked" />
            <local:NavButton x:Name="OptimizeButton"  IconSymbol="Gauge"             Text="Optimize"       NavigationTag="Optimize"    IsCompact="{x:Bind IsCompact, Mode=OneWay}" Clicked="NavButton_Clicked" />
            <local:NavButton x:Name="CustomizeButton" IconSymbol="DesignIdeas"       Text="Customize"      NavigationTag="Customize"   IsCompact="{x:Bind IsCompact, Mode=OneWay}" Clicked="NavButton_Clicked" />
            <local:NavButton x:Name="SoftwareButton"  IconSymbol="Apps"              Text="Software &amp; Apps" NavigationTag="SoftwareHub" IsCompact="{x:Bind IsCompact, Mode=OneWay}" Clicked="NavButton_Clicked" />
        </StackPanel>

        <!-- Bottom navigation group -->
        <StackPanel x:Name="BottomNavPanel" Grid.Row="3" Spacing="4" HorizontalAlignment="Center" Margin="0,0,0,8">
            <local:NavButton x:Name="AdvancedButton" IconSymbol="WrenchScrewdriver" Text="Advanced Tools" NavigationTag="AdvancedHub" IsCompact="{x:Bind IsCompact, Mode=OneWay}" Clicked="NavButton_Clicked" />
            <local:NavButton x:Name="SettingsButton" IconSymbol="Settings"          Text="Settings"       NavigationTag="Settings"    IsCompact="{x:Bind IsCompact, Mode=OneWay}" Clicked="NavButton_Clicked" />
        </StackPanel>
    </Grid>
</UserControl>
