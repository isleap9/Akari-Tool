<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AkariTool.Views.Controls.NavButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:FluentIcons.WinUI"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    AutomationProperties.Name="{x:Bind Text, Mode=OneWay}">

    <Grid x:Name="RootGrid"
          Width="{x:Bind ActualButtonWidth, Mode=OneWay}"
          Height="{x:Bind ActualButtonHeight, Mode=OneWay}"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited"
          PointerPressed="RootGrid_PointerPressed"
          PointerReleased="RootGrid_PointerReleased">

        <Border x:Name="BackgroundBorder" Background="Transparent" CornerRadius="8" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
            <!-- Colored Fluent icon; the enum Icon is assigned in code-behind from IconSymbol. -->
            <fluent:FluentIcon x:Name="ButtonFluentIcon"
                               IconVariant="Color"
                               FontSize="{x:Bind IconSize, Mode=OneWay}"
                               HorizontalAlignment="Center" />
            <TextBlock x:Name="ButtonText"
                       Text="{x:Bind Text, Mode=OneWay}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="2"
                       TextAlignment="Center"
                       MaxWidth="64"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind TextVisibility, Mode=OneWay}" />
        </StackPanel>

        <!-- Left accent selection indicator -->
        <Border x:Name="SelectionIndicator"
                Width="3" Height="16"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                CornerRadius="2"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Visibility="{x:Bind IndicatorVisibility, Mode=OneWay}" />

        <!-- Pending-count badge -->
        <InfoBadge x:Name="Badge"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,4,4,0"
                   Value="{x:Bind BadgeValue, Mode=OneWay}"
                   Visibility="{x:Bind BadgeVisibility, Mode=OneWay}" />
    </Grid>
</UserControl>
