<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AkariTool.Views.Controls.NavButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AkariTool.Views.Controls"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    AutomationProperties.Name="{x:Bind Text, Mode=OneWay}">

    <Grid x:Name="RootGrid"
          Width="{x:Bind ActualButtonWidth, Mode=OneWay}"
          Height="{x:Bind ActualButtonHeight, Mode=OneWay}"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited"
          PointerPressed="RootGrid_PointerPressed"
          PointerReleased="RootGrid_PointerReleased">

        <!-- Main button background: repainted in code (UpdateVisualState) for
             selected / hover / focus so a single Border covers all states. -->
        <Border x:Name="BackgroundBorder"
                Background="Transparent"
                CornerRadius="10" />

        <!-- Icon-over-text stack. Spacing 2 (not 4) so a 2-line label at higher
             Windows text-scale still fits the fixed 60dp button without clipping. -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="2"
                    Opacity="{x:Bind ContentOpacity, Mode=OneWay}">
            <!-- Colored Fluent icon. Icon is an enum, so it's assigned in code-behind
                 from the IconSymbol string DP (see OnIconPropertyChanged). -->
            <fluentIcons:FluentIcon x:Name="ButtonFluentIcon"
                                    IconVariant="Color"
                                    FontSize="{x:Bind IconSize, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    Margin="{x:Bind IconMargin, Mode=OneWay}"
                                    Visibility="{x:Bind FluentIconVisibility, Mode=OneWay}" />

            <TextBlock x:Name="ButtonText"
                       Text="{x:Bind Text, Mode=OneWay}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="2"
                       TextAlignment="Center"
                       MaxWidth="60"
                       HorizontalAlignment="Center"
                       Visibility="{x:Bind TextVisibility, Mode=OneWay}" />
        </StackPanel>

        <!-- Left selection indicator (accent pill). -->
        <Border x:Name="SelectionIndicator"
                Width="3"
                Height="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                CornerRadius="2"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Visibility="{x:Bind IndicatorVisibility, Mode=OneWay}" />

        <!-- InfoBadge overlay (nav pending counts). -->
        <InfoBadge x:Name="Badge"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,2,-4,0"
                   Visibility="{x:Bind BadgeVisibility, Mode=OneWay}"
                   Value="{x:Bind BadgeValue, Mode=OneWay}" />

        <!-- Loading overlay. -->
        <Border x:Name="LoadingOverlay"
                Background="#80000000"
                CornerRadius="10"
                Visibility="{x:Bind LoadingVisibility, Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}"
                          Width="24"
                          Height="24"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Border>

        <!-- Locked overlay (config-review lock; dims content + shows a lock glyph). -->
        <Grid Visibility="{x:Bind LockedVisibility, Mode=OneWay}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <fluentIcons:FluentIcon Icon="LockClosed"
                                    IconVariant="Regular"
                                    FontSize="14"
                                    Foreground="#FFA500" />
        </Grid>
    </Grid>
</UserControl>
