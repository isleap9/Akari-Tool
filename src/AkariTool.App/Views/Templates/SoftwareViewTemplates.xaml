<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared Software & Apps view-mode templates (Table + Compact). The Card view keeps each
    catalog page's existing per-section template; these two are swapped onto the same
    ItemsControl by the page code-behind when the shared toolbar's view-mode toggle changes.
    Both bind only to the shared AppSectionViewModel / AppCardViewModel, so one set serves
    both catalogs (the Permanent pill self-gates via AppCardViewModel.IsPermanent).

    Uses classic {Binding} (a standalone ResourceDictionary has no code-behind for {x:Bind}).
    Merged into App.xaml AFTER TweakTemplates.xaml so BoolToVis / InvBoolToVis resolve.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ COMPACT view ══ dense single-line rows, grouped by section ─────────── -->
    <DataTemplate x:Key="SoftwareSectionCompactTemplate">
        <StackPanel Margin="0,0,0,10"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,6,0,6" />
            <ItemsControl ItemsSource="{Binding VisibleCards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,5,8,5" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" MinWidth="0" VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding Name}" />

                            <Border Grid.Column="1" Width="22" Height="22" CornerRadius="5" VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <TextBlock Text="{Binding Letter}" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               Visibility="{Binding HasIcon, Converter={StaticResource InvBoolToVis}}" />
                                    <Image Source="{Binding Icon}" Width="18" Height="18"
                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>

                            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Padding="7,2" CornerRadius="4"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Installed" FontSize="10"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </Border>
                                <Border Padding="7,2" CornerRadius="4"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Warning" FontSize="10"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </Border>
                                <Border Padding="7,2" CornerRadius="4"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="{Binding IsPermanent, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Permanent" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- ══ TABLE view ══ columnar rows (checkbox | icon | name | description | status) ── -->
    <DataTemplate x:Key="SoftwareSectionTableTemplate">
        <StackPanel Margin="0,0,0,10"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,6,0,6" />
            <ItemsControl ItemsSource="{Binding VisibleCards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,8,8,8" ColumnSpacing="12"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" MinWidth="0" VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding Name}" />

                            <Border Grid.Column="1" Width="28" Height="28" CornerRadius="6" VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <TextBlock Text="{Binding Letter}" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               Visibility="{Binding HasIcon, Converter={StaticResource InvBoolToVis}}" />
                                    <Image Source="{Binding Icon}" Width="22" Height="22"
                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>

                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="3" Text="{Binding Description}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Padding="7,2" CornerRadius="4"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Installed" FontSize="10"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </Border>
                                <Border Padding="7,2" CornerRadius="4"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Warning" FontSize="10"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </Border>
                                <Border Padding="7,2" CornerRadius="4"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="{Binding IsPermanent, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Permanent" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
