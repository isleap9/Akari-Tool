                    Grid.ColumnSpan="2"
                    Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <Border Background="{ThemeResource SmokeFillColorDefaultBrush}" CornerRadius="4" />
                    <Button
                        Command="{Binding UnlockCommand}"
                        AutomationProperties.Name="{Binding ClickToUnlockText}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource PrivacyIconPath}" Fill="#FFA500" Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock Text="{Binding ClickToUnlockText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Dual AC/DC NumericRange spinners (Separate PowerCfg, laptop with battery). -->
    <DataTemplate x:Key="TweakDualNumericRowTemplate">
        <Border
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
            <Grid Margin="0,13,0,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            TextWrapping="Wrap" />
                        <Border
                            Style="{StaticResource NewBadgeBorderStyle}"
                            Visibility="{Binding ShowNewBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Style="{StaticResource NewBadgeTextStyle}"
                                Text="{Binding NewBadgeText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Description}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,2,0,0"
                        TextWrapping="Wrap" />
                    <ItemsControl
                        ItemsSource="{Binding Badges}"
                        ItemsPanel="{StaticResource HorizontalItemsPanel}"
                        ItemTemplateSelector="{StaticResource BadgeSelector}"
                        Margin="0,5,0,0"
                        Visibility="{Binding HasBadges, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Plugged In" FontSize="12" Opacity="0.8" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button
                                Style="{StaticResource AkariChromelessButtonStyle}"
                                Width="28" Height="28"
                                Command="{Binding ApplyAcRecommendedCommand}"
                                ToolTipService.ToolTip="{Binding RecommendedAcTooltip}"
                                AutomationProperties.Name="{Binding RecommendedAcTooltip}"
                                Visibility="{Binding HasAcRecommendedQuickSet, Converter={StaticResource BoolToVis}}">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE735;" FontSize="15"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </Button>
                            <Button
                                Style="{StaticResource AkariChromelessButtonStyle}"
                                Width="28" Height="28"
                                Command="{Binding ApplyAcDefaultCommand}"
                                ToolTipService.ToolTip="{Binding DefaultAcTooltip}"
                                AutomationProperties.Name="{Binding DefaultAcTooltip}"
                                Visibility="{Binding HasAcDefaultQuickSet, Converter={StaticResource BoolToVis}}">
                                <Grid Width="13" Height="13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="6" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="6" />
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="{StaticResource AkariWindowsLogoBrush}" />
                                    <Rectangle Grid.Row="0" Grid.Column="2" Fill="{StaticResource AkariWindowsLogoBrush}" />
                                    <Rectangle Grid.Row="2" Grid.Column="0" Fill="{StaticResource AkariWindowsLogoBrush}" />
                                    <Rectangle Grid.Row="2" Grid.Column="2" Fill="{StaticResource AkariWindowsLogoBrush}" />
                                </Grid>
                            </Button>
                            <NumberBox
                                Value="{Binding AcNumericValue, Mode=TwoWay}"
                                Minimum="{Binding MinValue}"
                                Maximum="{Binding MaxValue}"
                                SpinButtonPlacementMode="Inline"
                                SmallChange="1"
                                LargeChange="10"
                                MinWidth="120"
                                AutomationProperties.Name="{Binding Name}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="On Battery" FontSize="12" Opacity="0.8" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button
                                Style="{StaticResource AkariChromelessButtonStyle}"
                                Width="28" Height="28"
                                Command="{Binding ApplyDcRecommendedCommand}"
                                ToolTipService.ToolTip="{Binding RecommendedDcTooltip}"
                                AutomationProperties.Name="{Binding RecommendedDcTooltip}"
                                Visibility="{Binding HasDcRecommendedQuickSet, Converter={StaticResource BoolToVis}}">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE735;" FontSize="15"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </Button>
                            <Button
                                Style="{StaticResource AkariChromelessButtonStyle}"
                                Width="28" Height="28"
                                Command="{Binding ApplyDcDefaultCommand}"
                                ToolTipService.ToolTip="{Binding DefaultDcTooltip}"
                                AutomationProperties.Name="{Binding DefaultDcTooltip}"
                                Visibility="{Binding HasDcDefaultQuickSet, Converter={StaticResource BoolToVis}}">
                                <Grid Width="13" Height="13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="6" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="6" />
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="{StaticResource AkariWindowsLogoBrush}" />
                                    <Rectangle Grid.Row="0" Grid.Column="2" Fill="{StaticResource AkariWindowsLogoBrush}" />
                                    <Rectangle Grid.Row="2" Grid.Column="0" Fill="{StaticResource AkariWindowsLogoBrush}" />
                                    <Rectangle Grid.Row="2" Grid.Column="2" Fill="{StaticResource AkariWindowsLogoBrush}" />
                                </Grid>
                            </Button>
                            <NumberBox
                                Value="{Binding DcNumericValue, Mode=TwoWay}"
                                Minimum="{Binding MinValue}"
                                Maximum="{Binding MaxValue}"
                                SpinButtonPlacementMode="Inline"
                                SmallChange="1"
                                LargeChange="10"
                                MinWidth="120"
                                AutomationProperties.Name="{Binding Name}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Advanced-unlock lock overlay (Winhance port): dims the whole row
                     until the one-time warning dialog is accepted. -->
                <Grid
                    Grid.ColumnSpan="2"
                    Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <Border Background="{ThemeResource SmokeFillColorDefaultBrush}" CornerRadius="4" />
                    <Button
                        Command="{Binding UnlockCommand}"
                        AutomationProperties.Name="{Binding ClickToUnlockText}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource PrivacyIconPath}" Fill="#FFA500" Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock Text="{Binding ClickToUnlockText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <selectors:TweakRowTemplateSelector
        x:Key="TweakRowSelector"
        ToggleTemplate="{StaticResource TweakToggleRowTemplate}"
        DropdownTemplate="{StaticResource TweakDropdownRowTemplate}"
        PlanTemplate="{StaticResource TweakPowerPlanRowTemplate}"
        NumericTemplate="{StaticResource TweakNumericRowTemplate}"
        SingleACNumericTemplate="{StaticResource TweakSingleACNumericRowTemplate}"
        DualNumericTemplate="{StaticResource TweakDualNumericRowTemplate}" />

    <!-- ══════════════════════════════════════════════════════════════════════
         SECTION CARD  (header + bulk bar + rows)
         ══════════════════════════════════════════════════════════════════════ -->

    <DataTemplate x:Key="TweakSectionTemplate">
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="0,0,0,16"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}, TargetNullValue=Visible, FallbackValue=Visible}">
            <StackPanel Margin="18,14,18,14">

                <!-- Flat header: title (left) + bulk actions (right). No collapse. -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="{Binding Title}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        VerticalAlignment="Center" />

                    <!-- Bulk bar: pending text + ★ Recommended + Defaults. Shown only
                         when the section has recommended targets (HasBulkBar). -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasBulkBar, Converter={StaticResource BoolToVis}}">

                        <TextBlock
                            Text="{Binding PendingText}"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Opacity="{Binding PendingOpacity}"
                            ToolTipService.ToolTip="{Binding PendingTooltip}" />

                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding ApplyRecommendedCommand}"
                            ToolTipService.ToolTip="Apply the recommended value to every setting in this section"
                            AutomationProperties.Name="Apply recommended values to this section">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE735;"
                                          FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Recommended" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            Command="{Binding ApplyDefaultsCommand}"
                            Content="Defaults"
                            ToolTipService.ToolTip="Reset every setting in this section to its Windows default"
                            AutomationProperties.Name="Reset this section to Windows defaults" />
                    </StackPanel>
                </Grid>

                <!-- Body: always visible (collapse removed). -->
                <ItemsControl
                    ItemsSource="{Binding Items}"
                    ItemTemplateSelector="{StaticResource TweakRowSelector}" />
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
