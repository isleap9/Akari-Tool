<?xml version="1.0" encoding="utf-8"?>
<!--
    THE TWEAK RENDERING LAYER (MVVM replacement for the net8 TweakHelpers factory).

    One render path for every tweak tab: a section card template, two row templates
    (toggle / dropdown) chosen by TweakRowTemplateSelector, and four badge templates
    chosen by TweakBadgeTemplateSelector. A tab supplies only data — so a change
    made here propagates to every tab, which is exactly the leverage the imperative
    factory had.

    COLOURS: stock Fluent {ThemeResource} brushes. The Akari crimson token
    dictionary (PillAccentBg / StarGold / WinBlueIcon / Hairline …) has NOT been
    ported into this build yet — see MIGRATION_LOG. Everything here is a
    one-dictionary swap away once it is.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinUI.Framework.Converters"
    xmlns:selectors="using:AkariTool.Views.Selectors"
    xmlns:controls="using:AkariTool.Views.Controls">

    <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- The ⊞ "Windows default" mark keeps the Windows-brand blue in BOTH themes —
         it is NOT the Akari accent, so it must NOT follow the crimson accent tokens. -->
    <SolidColorBrush x:Key="AkariWindowsLogoBrush" Color="#FF0078D4" />

    <!-- Winhance's orange padlock (PrivacyIconPath) for the advanced-unlock overlay. -->
    <x:String x:Key="PrivacyIconPath">M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z</x:String>

    <!-- Winhance-style NEW pill (red fill, white text) for freshly added settings.
         Rows opt in via AddedInVersion in the catalog; visibility is ShowNewBadge. -->
    <Style x:Key="NewBadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#E81123" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="NewBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Chromeless host for quick-set / bulk / header buttons: the content (glyph
         or pill) is the only visible chrome. Hover keeps the native WinUI subtle
         fill rather than net8's fully-nulled hover — a deliberate native-first
         deviation, flagged in MIGRATION_LOG. -->
    <Style x:Key="AkariChromelessButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         BADGE PILLS  (one template per kind so colours stay live {ThemeResource})
         ══════════════════════════════════════════════════════════════════════ -->

    <DataTemplate x:Key="BadgeRecommendedTemplate">
        <Border
            Background="Transparent"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,2"
            Margin="0,0,6,0"
            Opacity="{Binding PillOpacity}"
            ToolTipService.ToolTip="{Binding Tooltip}">
            <TextBlock
                Text="{Binding Label}"
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                VerticalAlignment="Center" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="BadgeDefaultTemplate">
        <Border
            Background="Transparent"
            BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,2"
            Margin="0,0,6,0"
            Opacity="{Binding PillOpacity}"
            ToolTipService.ToolTip="{Binding Tooltip}">
            <TextBlock
                Text="{Binding Label}"
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="BadgeCustomTemplate">
        <Border
            Background="Transparent"
            BorderBrush="{ThemeResource TextFillColorTertiaryBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,2"
            Margin="0,0,6,0"
            Opacity="{Binding PillOpacity}"
            ToolTipService.ToolTip="{Binding Tooltip}">
            <TextBlock
                Text="{Binding Label}"
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                VerticalAlignment="Center" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="BadgePreferenceTemplate">
        <Border
            Background="Transparent"
            BorderBrush="{ThemeResource TextFillColorDisabledBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,2"
            Margin="0,0,6,0"
            Opacity="{Binding PillOpacity}"
            ToolTipService.ToolTip="{Binding Tooltip}">
            <TextBlock
                Text="{Binding Label}"
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                VerticalAlignment="Center" />
        </Border>
    </DataTemplate>

    <selectors:TweakBadgeTemplateSelector
        x:Key="BadgeSelector"
        RecommendedTemplate="{StaticResource BadgeRecommendedTemplate}"
        DefaultTemplate="{StaticResource BadgeDefaultTemplate}"
        CustomTemplate="{StaticResource BadgeCustomTemplate}"
        PreferenceTemplate="{StaticResource BadgePreferenceTemplate}" />

    <ItemsPanelTemplate x:Key="HorizontalItemsPanel">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- ══════════════════════════════════════════════════════════════════════
         TWEAK ROWS
         ══════════════════════════════════════════════════════════════════════ -->

    <DataTemplate x:Key="TweakToggleRowTemplate">
        <Border
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
            <Grid Margin="0,13,0,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            TextWrapping="Wrap" />
                        <Border
                            Style="{StaticResource NewBadgeBorderStyle}"
                            Visibility="{Binding ShowNewBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Style="{StaticResource NewBadgeTextStyle}"
                                Text="{Binding NewBadgeText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Description}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,2,0,0"
                        TextWrapping="Wrap" />
                    <ItemsControl
                        ItemsSource="{Binding Badges}"
                        ItemsPanel="{StaticResource HorizontalItemsPanel}"
                        ItemTemplateSelector="{StaticResource BadgeSelector}"
                        Margin="0,5,0,0"
                        Visibility="{Binding HasBadges, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- ★ apply recommended -->
                    <Button
                        Style="{StaticResource AkariChromelessButtonStyle}"
                        Width="28" Height="28"
                        Command="{Binding ApplyRecommendedCommand}"
                        ToolTipService.ToolTip="{Binding RecommendedTooltip}"
                        AutomationProperties.Name="{Binding RecommendedTooltip}"
                        Visibility="{Binding HasRecommendedQuickSet, Converter={StaticResource BoolToVis}}">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE735;"
                            FontSize="15"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </Button>
                    <!-- ⊞ apply Windows default (2x2 logo mark) -->
                    <Button
                        Style="{StaticResource AkariChromelessButtonStyle}"
                        Width="28" Height="28"
                        Command="{Binding ApplyDefaultCommand}"
                        ToolTipService.ToolTip="{Binding DefaultTooltip}"
                        AutomationProperties.Name="{Binding DefaultTooltip}"
                        Visibility="{Binding HasDefaultQuickSet, Converter={StaticResource BoolToVis}}">
                        <Grid Width="13" Height="13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="6" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="6" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="6" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{StaticResource AkariWindowsLogoBrush}" />
                            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{StaticResource AkariWindowsLogoBrush}" />
                            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{StaticResource AkariWindowsLogoBrush}" />
                            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{StaticResource AkariWindowsLogoBrush}" />
                        </Grid>
                    </Button>

                    <ToggleSwitch
                        IsOn="{Binding IsOn, Mode=TwoWay}"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Name}" />
                </StackPanel>

                <!-- Advanced-unlock lock overlay (Winhance port): dims the whole row
                     until the one-time warning dialog is accepted. -->
                <Grid
                    Grid.ColumnSpan="2"
                    Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <Border Background="{ThemeResource SmokeFillColorDefaultBrush}" CornerRadius="4" />
                    <Button
                        Command="{Binding UnlockCommand}"
                        AutomationProperties.Name="{Binding ClickToUnlockText}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource PrivacyIconPath}" Fill="#FFA500" Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock Text="{Binding ClickToUnlockText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

