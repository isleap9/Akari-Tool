<?xml version="1.0" encoding="utf-8"?>
<!--
    Software & Apps hub (rail tag "SoftwareHub"). Hosts the shared HubView chrome and supplies
    its cards: Windows Apps, External Apps, Debloat. These are app-catalog pages (not settings
    pages), so no pills and the hub search is hidden — each page keeps its own action bar /
    search / select-all toolbar inside the hub inner frame. Folds the old SOFTWARE group's
    three rail entries into one hub.
-->
<Page
    x:Class="AkariTool.Views.SoftwareHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AkariTool.Views.Controls"
    NavigationCacheMode="Required">

    <controls:HubView x:Name="Hub" />
</Page>
