<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings (rail tag "Settings") — merged tab. Appearance full-width at top; below it a
    two-column Grid: left = Updates (status card + actions + "What's new" changelog),
    right = About (header + Environment/Credits + links). Even split; the two columns are
    top-aligned and the whole page scrolls as one ScrollViewer (Updates is the taller
    column — expected, not clipped). NOT a tweak page — registers nothing.
-->
<Page
    x:Class="AkariTool.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AkariTool.ViewModels"
    xmlns:selectors="using:AkariTool.Views.Selectors"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Changelog line templates: a header stands out (SemiBold + top gap), bullets
             read as a hanging-indent list, paragraphs wrap normally. -->
        <DataTemplate x:Key="ChangelogHeaderTemplate" x:DataType="vm:ChangelogLine">
            <TextBlock
                Text="{x:Bind Text}"
                FontSize="12.5"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                TextWrapping="Wrap"
                Margin="0,10,0,3" />
        </DataTemplate>

        <DataTemplate x:Key="ChangelogBulletTemplate" x:DataType="vm:ChangelogLine">
            <Grid Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="&#x2022;"
                    FontSize="12.5"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Text}"
                    FontSize="12.5"
                    LineHeight="18"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChangelogParagraphTemplate" x:DataType="vm:ChangelogLine">
            <TextBlock
                Text="{x:Bind Text}"
                FontSize="12.5"
                LineHeight="18"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="0,0,0,2" />
        </DataTemplate>

        <selectors:ChangelogLineTemplateSelector
            x:Key="ChangelogLineSelector"
            HeaderTemplate="{StaticResource ChangelogHeaderTemplate}"
            BulletTemplate="{StaticResource ChangelogBulletTemplate}"
            ParagraphTemplate="{StaticResource ChangelogParagraphTemplate}" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,24,32,24" Spacing="16">

            <TextBlock
                Text="Settings"
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <!-- ── Appearance (flat) ─────────────────────────────────────────── -->
            <TextBlock Margin="0,8,0,0" Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ComboBox
                Header="Theme"
                MinWidth="220"
                HorizontalAlignment="Left"
                ItemsSource="{x:Bind ViewModel.Themes}"
                SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />

            <!-- ── Two columns: Updates | About ──────────────────────────────── -->
            <Grid Margin="0,8,0,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left column: Updates -->
                <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Top">
                    <TextBlock Text="Updates" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border
                        Padding="22,20,22,20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="14">
                            <InfoBar
                                IsOpen="True"
                                IsClosable="False"
                                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                                Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                                Message="{x:Bind ViewModel.StatusDetail, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing
                                    Width="20" Height="20"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                                <Button
                                    Content="{x:Bind ViewModel.UpdateActionText, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="18,0,18,0"
                                    Visibility="{x:Bind ViewModel.UpdateButtonVisibility, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.UpdateNowCommand}" />
                                <Button
                                    Content="Check for Updates"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="18,0,18,0"
                                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="What's new" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border
                        Padding="20,4,20,4"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <ScrollViewer
                            x:Name="ChangelogScroller"
                            MaxHeight="320"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Changelog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReleaseNote">
                                        <Grid Margin="0,14,0,14" ColumnSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Text="{x:Bind Version}"
                                                FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                                VerticalAlignment="Top"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <Border
                                                    Visibility="{x:Bind CurrentPillVisibility}"
                                                    HorizontalAlignment="Left"
                                                    Padding="9,2,9,2"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                                    BorderThickness="1">
                                                    <TextBlock Text="CURRENT" FontFamily="Consolas" FontSize="9"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </Border>
                                                <ItemsControl
                                                    ItemsSource="{x:Bind Lines}"
                                                    ItemTemplateSelector="{StaticResource ChangelogLineSelector}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <HyperlinkButton
                        x:Name="ChangelogToggle"
                        Content="Show more"
                        HorizontalAlignment="Left"
                        Padding="0,2,0,2"
                        Margin="0,-4,0,0"
                        Click="ChangelogToggle_Click" />
                </StackPanel>

                <!-- Right column: About (cards built in code-behind → AboutHost) -->
                <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Top">
                    <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel x:Name="AboutHost" Spacing="12" />
                </StackPanel>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
