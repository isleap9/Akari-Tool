<?xml version="1.0" encoding="utf-8"?>
<!--
    Software & Apps (rail tag "SoftwareHub") — Winhance-style single tabbed page. A hub-style
    header with search, a shared toolbar (Install / Uninstall / Refresh + selected count) that
    drives whichever tab is active, a two-segment tab header (Windows Apps & Features / External
    Software), and an inner frame hosting the catalog pages. The toolbar + search bind to the
    active catalog VM via the page DataContext (set on tab switch). Stage B; Card/Table/Compact
    view modes + Sort are Stage C.
-->
<Page
    x:Class="AkariTool.Views.SoftwareAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid Padding="28,0,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header + search -->
            <RowDefinition Height="Auto" />  <!-- Shared toolbar -->
            <RowDefinition Height="Auto" />  <!-- Tabs -->
            <RowDefinition Height="*" />     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header + search -->
        <Grid Grid.Row="0" Margin="0,24,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Viewbox Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center">
                    <TextBlock
                        Text="&#xE71D;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Viewbox>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Text="Software &amp; Apps"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock
                        Text="Manage Windows apps and install software."
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Margin="0,2,0,0"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
            <AutoSuggestBox
                Grid.Column="1"
                Width="260"
                VerticalAlignment="Bottom"
                QueryIcon="Find"
                PlaceholderText="Search apps…"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Shared toolbar: acts on the active tab's VM (via page DataContext). -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,0,0,12" VerticalAlignment="Center">
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="15,5" VerticalAlignment="Center"
                    Margin="0,0,6,0">
                <TextBlock Text="{Binding SelectedCountText}" FontSize="12"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Border>

            <Button Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding InstallSelectedCommand}"
                    IsEnabled="{Binding ButtonsEnabled}"
                    AutomationProperties.Name="Install Selected">
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Install Selected" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Command="{Binding UninstallCommand}"
                    IsEnabled="{Binding ButtonsEnabled}"
                    AutomationProperties.Name="Uninstall Selected">
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Uninstall Selected" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Command="{Binding RefreshStatusCommand}"
                    IsEnabled="{Binding ButtonsEnabled}"
                    AutomationProperties.Name="Refresh">
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- View-mode toggles: Card / Table / Compact -->
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="ViewCard" Tag="Card" Click="ViewMode_Click"
                                  Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="9,5"
                                  ToolTipService.ToolTip="Card view" AutomationProperties.Name="Card view">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE80A;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="ViewTable" Tag="Table" Click="ViewMode_Click"
                                  Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="9,5"
                                  ToolTipService.ToolTip="Table view" AutomationProperties.Name="Table view">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7B3;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="ViewCompact" Tag="Compact" Click="ViewMode_Click"
                                  Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="9,5"
                                  ToolTipService.ToolTip="Compact view" AutomationProperties.Name="Compact view">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FD;" FontSize="14" />
                    </ToggleButton>
                </StackPanel>
            </Border>

            <DropDownButton AutomationProperties.Name="Sort">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8CB;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                    <TextBlock Text="Sort" VerticalAlignment="Center" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <RadioMenuFlyoutItem x:Name="SortNameAsc" Text="Name (A–Z)" GroupName="SoftwareSort"
                                             Tag="NameAsc" Click="Sort_Click" IsChecked="True" />
                        <RadioMenuFlyoutItem x:Name="SortNameDesc" Text="Name (Z–A)" GroupName="SoftwareSort"
                                             Tag="NameDesc" Click="Sort_Click" />
                        <MenuFlyoutSeparator />
                        <RadioMenuFlyoutItem x:Name="SortInstalledFirst" Text="Installed first" GroupName="SoftwareSort"
                                             Tag="InstalledFirst" Click="Sort_Click" />
                        <RadioMenuFlyoutItem x:Name="SortNotInstalledFirst" Text="Not installed first" GroupName="SoftwareSort"
                                             Tag="NotInstalledFirst" Click="Sort_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>

        <!-- Two-segment tab header -->
        <Border Grid.Row="2"
                Margin="0,0,0,12"
                CornerRadius="8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="TabWindows" Grid.Column="0"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              Background="Transparent" BorderThickness="0" CornerRadius="6"
                              Padding="10,8" Click="Tab_Click" Tag="Windows">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71D;" FontSize="14" />
                        <TextBlock Text="Windows Apps &amp; Features" FontWeight="SemiBold" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TabExternal" Grid.Column="1"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              Background="Transparent" BorderThickness="0" CornerRadius="6"
                              Padding="10,8" Click="Tab_Click" Tag="External">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" FontSize="14" />
                        <TextBlock Text="External Software" FontWeight="SemiBold" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Content panel: the active catalog page (status + select-all + grid) inside the frame. -->
        <Border Grid.Row="3"
                Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                CornerRadius="8"
                Margin="0,0,0,12">
            <Frame x:Name="TabFrame" />
        </Border>
    </Grid>
</Page>
