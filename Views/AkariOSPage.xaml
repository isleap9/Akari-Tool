<?xml version="1.0" encoding="utf-8"?>
<!--
    AkariOS (rail tag "AkariOS") — MVVM port of net8 AkariOSTab.
    A single continuous page of collapsible cards over already-ported backing services
    (PostInstallService, ServicesPreset, PlaybookTweaks, BcdBackup, GpuTweaks,
    CompetitiveService, ShaderCacheService, NvidiaProfileService, ToolFetchService,
    AccountService, SystemUtilities).

    The interactive UI (SYSTEM-elevation writes, reboot-gated scripts, live drift
    rendering, the Competitive game launcher) is built in the page code-behind — a
    faithful port of net8's imperative builders, like Advanced Tools — because it is far
    more stateful than the card/list panels ported as DataTemplates. This XAML is just
    the scroll host + the RootPanel the code-behind fills. NOT a tweak page — registers
    nothing, so it stays out of the [WARMUP] tiling.

    Port status: PostInstall banner ported (Phase 11); the other sections are visible
    stubs pending per-section sign-off.
-->
<Page
    x:Class="AkariTool.Views.AkariOSPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,24" MaxWidth="960" HorizontalAlignment="Center">
            <!-- Page header (net8 PageHeader "AkariOS") -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock
                    Text="AkariOS"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="AkariOS presets and system configuration."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="0,4,0,0"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Filled by code-behind, in net8 Build() order:
                 PostInstall banner (ported) → Gaming Tweaks card → Utilities → Useful Tools. -->
            <StackPanel x:Name="RootPanel" Spacing="0" />
        </StackPanel>
    </ScrollViewer>
</Page>
