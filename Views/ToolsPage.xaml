<?xml version="1.0" encoding="utf-8"?>
<!--
    Tools (rail tag "Tools") — Phase 9 port of net8 ToolsTab. Five sections built in the
    code-behind: System Information (read-only WMI/registry + Copy), Repair & Health /
    Network / Maintenance (Run buttons → ToolService.RunScript of already-embedded ps1),
    and Quick Shortcuts (Process.Start shell-execute). NOT a tweak page — registers nothing.
-->
<Page
    x:Class="AkariTool.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,24" MaxWidth="960" HorizontalAlignment="Center">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Tools" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="System utilities, repair tools, and quick shortcuts." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="RootPanel" />
        </StackPanel>
    </ScrollViewer>
</Page>
