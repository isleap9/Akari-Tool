<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AkariTool.Views.PowerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="using:AkariTool.Views.Selectors"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Bespoke Plan Selector + Persist Indicator card (Power-only, Phase 21).
             Faithful to net8: 3 fixed plan cards + a dynamic Custom card, each with an
             ACTIVE tag + click-to-activate; below, the persistence indicator line and a
             (no-confirmation) "Revert to Balanced" button. NOT tweak rows. -->
        <DataTemplate x:Key="PowerPlanSelectorTemplate">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,0,16">
                <StackPanel Margin="18,16,18,16">
                    <TextBlock
                        Text="POWER PLAN"
                        FontFamily="Consolas"
                        FontSize="10"
                        FontWeight="Medium"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Margin="0,0,0,10" />

                    <!-- Plan cards row -->
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Command="{Binding ActivateCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="0,0,9,0"
                                    Width="210"
                                    HorizontalContentAlignment="Stretch"
                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.Name="{Binding Label}">
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="15,13">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{Binding Label}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    TextWrapping="Wrap"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="ACTIVE"
                                                    FontFamily="Consolas"
                                                    FontSize="9"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="6,0,0,0"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                            <TextBlock
                                                Text="{Binding Description}"
                                                FontSize="11.5"
                                                LineHeight="16"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap"
                                                Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Persist indicator + Revert to Balanced -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding PersistText}"
                            Foreground="{Binding PersistBrush}"
                            FontFamily="Consolas"
                            FontSize="11"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="1"
                            Content="Revert to Balanced"
                            FontSize="12"
                            Padding="12,4"
                            Command="{Binding RevertToBalancedCommand}"
                            Visibility="{Binding RevertVisible, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Reactivate the Windows Balanced plan and delete the Akari Performance scheme" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Renders each DisplayItems entry by type: plan selector (above) or the
             shared tweak-section card. -->
        <selectors:PowerSectionTemplateSelector
            x:Key="PowerSectionSelector"
            SectionTemplate="{StaticResource TweakSectionTemplate}"
            PlanSelectorTemplate="{StaticResource PowerPlanSelectorTemplate}" />
    </Page.Resources>

    <!-- NavigationCacheMode="Required": the page view model is a DI SINGLETON
         (rows register once with TweakRegistry and there is no unregister), so the
         Frame must reuse this page instance rather than rebuild it per navigation.
         Layout is identical to GamingPage — every binding targets TweakPageViewModel
         base members, so this is a pure copy+retitle. -->

    <ScrollViewer>
        <StackPanel Padding="32,24,32,24" MaxWidth="1100" HorizontalAlignment="Center">

            <!-- ── Page header: title + search + Quick actions ──────────────── -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,4,0,0"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Top">

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="240"
                        PlaceholderText="Find a setting…"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Find a setting on this page" />

                    <Button
                        x:Name="QuickActionsButton"
                        Padding="12,7,10,7"
                        CornerRadius="8"
                        AutomationProperties.Name="Quick actions"
                        ToolTipService.ToolTip="Bulk actions for every tweak on this page">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE945;"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="Quick actions"
                                FontSize="12"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE70D;"
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Margin="7,1,0,0"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <Button.Flyout>
                            <Flyout x:Name="QuickActionsFlyout" Opening="QuickActionsFlyout_Opening">
                                <StackPanel MinWidth="280">

                                    <Button
                                        Click="QuickActionItem_Click"
                                        Command="{x:Bind ViewModel.ApplyAllRecommendedCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6,4"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                Glyph="&#xE735;"
                                                FontSize="14"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Margin="2,0,10,0"
                                                VerticalAlignment="Center" />
                                            <StackPanel Margin="0,4">
                                                <TextBlock
                                                    Text="Apply all recommended"
                                                    FontSize="13"
                                                    FontWeight="SemiBold" />
                                                <TextBlock
                                                    Text="{x:Bind ViewModel.RecommendedPendingSubtitle, Mode=OneWay}"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Margin="0,1,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Click="QuickActionItem_Click"
                                        Command="{x:Bind ViewModel.RestoreDefaultsCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6,4"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                Glyph="&#xE777;"
                                                FontSize="14"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Margin="2,0,10,0"
                                                VerticalAlignment="Center" />
                                            <StackPanel Margin="0,4">
                                                <TextBlock
                                                    Text="Restore Windows defaults"
                                                    FontSize="13"
                                                    FontWeight="SemiBold" />
                                                <TextBlock
                                                    Text="{x:Bind ViewModel.DefaultPendingSubtitle, Mode=OneWay}"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Margin="0,1,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Border
                                        Height="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        Margin="4" />

                                    <Button
                                        Click="QuickActionItem_Click"
                                        Command="{x:Bind ViewModel.CreateRestorePointCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6,4"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                Glyph="&#xE7B8;"
                                                FontSize="14"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Margin="2,0,10,0"
                                                VerticalAlignment="Center" />
                                            <StackPanel Margin="0,4">
                                                <TextBlock
                                                    Text="Create restore point"
                                                    FontSize="13"
                                                    FontWeight="SemiBold" />
                                                <TextBlock
                                                    Text="System snapshot before you change anything"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Margin="0,1,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Plan Selector (top) + catalog sections ───────────────────── -->
            <ItemsControl
                ItemsSource="{x:Bind ViewModel.DisplayItems, Mode=OneWay}"
                ItemTemplateSelector="{StaticResource PowerSectionSelector}" />

        </StackPanel>
    </ScrollViewer>
</Page>
