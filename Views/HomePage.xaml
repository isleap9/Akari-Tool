<?xml version="1.0" encoding="utf-8"?>
<!--
    Home (rail tag "Home") — Phase 9 real port replacing the Phase-A demo stub.
    System-info banner (bound to the trimmed HomeViewModel) + a global search wired to
    TweakRegistry.Search + a quick-nav card grid, both built in the code-behind. NOT a
    tweak page — registers nothing.
-->
<Page
    x:Class="AkariTool.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,24" MaxWidth="1000" HorizontalAlignment="Center">

            <StackPanel Margin="0,0,0,16">
                <TextBlock
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="0,4,0,0"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- System information banner -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,16,20,16"
                Margin="0,0,0,16">
                <Grid ColumnSpacing="24" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Edition" FontFamily="Consolas" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Edition, Mode=OneWay}" FontFamily="Consolas" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" FontFamily="Consolas" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Version, Mode=OneWay}" FontFamily="Consolas" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU" FontFamily="Consolas" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Cpu, Mode=OneWay}" FontFamily="Consolas" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="GPU" FontFamily="Consolas" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Gpu, Mode=OneWay}" FontFamily="Consolas" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Memory" FontFamily="Consolas" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.Memory, Mode=OneWay}" FontFamily="Consolas" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- Global search across every tab (TweakRegistry.Search) -->
            <AutoSuggestBox
                x:Name="SearchBox"
                PlaceholderText="Search all tweaks across every tab…"
                QueryIcon="Find"
                FontSize="14"
                Height="44"
                Margin="0,0,0,16"
                TextChanged="SearchBox_TextChanged"
                AutomationProperties.Name="Search all tweaks" />

            <!-- Search results (code-filled; shown while searching) -->
            <Border
                x:Name="ResultsCard"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18,10,18,10"
                Visibility="Collapsed">
                <StackPanel x:Name="ResultsPanel" />
            </Border>

            <!-- Quick-nav card grid (code-filled; shown when not searching) -->
            <StackPanel x:Name="CardsPanel" />

        </StackPanel>
    </ScrollViewer>
</Page>
