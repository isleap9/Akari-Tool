<?xml version="1.0" encoding="utf-8"?>
<!--
  Borderless startup splash (WinUI 3 port).

  MIGRATION notes vs the WPF original:
   • WPF Window chrome properties (WindowStyle=None, ResizeMode, AllowsTransparency,
     Topmost, WindowStartupLocation, ShowInTaskbar, Background) have no XAML
     equivalents on a WinUI Window — they are applied in code via AppWindow +
     OverlappedPresenter (see SplashWindow.xaml.cs).
   • The two XAML Storyboards (DotSb / FadeUpSb) are declared here as in WPF, but
     WinUI requires EnableDependentAnimation on Opacity/translate animations.
   • RenderOptions.BitmapScalingMode dropped (no WinUI equivalent).
-->
<Window
    x:Class="AkariTool.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Akari Tool">

    <Grid x:ConnectionId='2' x:Name="SplashRoot" Background="{ThemeResource AkariFlatBackdrop}">
        <Grid.Resources>
            <Storyboard x:Key="DotSb" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="StatusDot"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.35" To="1" Duration="0:0:0.45"
                                 EnableDependentAnimation="True">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Key="FadeUpSb">
                <DoubleAnimation Storyboard.TargetName="ContentBlock"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.45"
                                 EnableDependentAnimation="True">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="ContentTranslate"
                                 Storyboard.TargetProperty="Y"
                                 From="14" To="0" Duration="0:0:0.45"
                                 EnableDependentAnimation="True">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <!-- Centered brand block (optically above true center) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,96">
            <Image x:ConnectionId='9' x:Name="LogoImage" Width="180" HorizontalAlignment="Center"/>
            <TextBlock Text="Akari Tool" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                       FontSize="30" HorizontalAlignment="Center" Margin="0,24,0,0"
                       Foreground="{ThemeResource AkariTextPrimary}"/>
            <TextBlock Text="System optimization &amp; management utility" FontFamily="{StaticResource BodyFont}"
                       FontSize="13" HorizontalAlignment="Center" Margin="0,9,0,0"
                       Foreground="{ThemeResource AkariTextSecondary}"/>
        </StackPanel>

        <!-- Bottom content block (fadeUp) -->
        <StackPanel x:ConnectionId='3' x:Name="ContentBlock" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,54" Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform x:ConnectionId='4' x:Name="ContentTranslate" Y="14"/>
            </StackPanel.RenderTransform>

            <Grid Width="560" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse x:ConnectionId='7' x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{ThemeResource AkariAccent}"/>
                        <TextBlock x:ConnectionId='8' x:Name="StatusText" Text="Checking administrator privileges" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource MonoFont}" FontSize="13"
                                   Foreground="{ThemeResource AkariTextSecondary}"/>
                    </StackPanel>
                    <TextBlock x:ConnectionId='6' x:Name="PercentText" Grid.Column="1" Text="0%" Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="13"
                               Foreground="{ThemeResource AkariTextMuted}"/>
                </Grid>

                <!-- Segment bar (7 pips) -->
                <Grid x:ConnectionId='5' x:Name="PipRow" Grid.Row="1" Margin="0,14,0,0" Height="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="4" CornerRadius="3" Background="{ThemeResource AkariHairline}" Margin="0,0,3,0"/>
                    <Border Grid.Column="1" Height="4" CornerRadius="3" Background="{ThemeResource AkariHairline}" Margin="3,0,3,0"/>
                    <Border Grid.Column="2" Height="4" CornerRadius="3" Background="{ThemeResource AkariHairline}" Margin="3,0,3,0"/>
                    <Border Grid.Column="3" Height="4" CornerRadius="3" Background="{ThemeResource AkariHairline}" Margin="3,0,3,0"/>
                    <Border Grid.Column="4" Height="4" CornerRadius="3" Background="{ThemeResource AkariHairline}" Margin="3,0,3,0"/>
                    <Border Grid.Column="5" Height="4" CornerRadius="3" Background="{ThemeResource AkariHairline}" Margin="3,0,3,0"/>
                    <Border Grid.Column="6" Height="4" CornerRadius="3" Background="{ThemeResource AkariHairline}" Margin="3,0,0,0"/>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</Window>

