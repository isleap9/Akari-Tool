<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AkariTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Akari Tool">

    <Grid x:ConnectionId='2' x:Name="RootGrid" Background="{ThemeResource AkariFlatBackdrop}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Custom title bar (draggable) ═══ -->
        <Grid x:ConnectionId='3' x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="14,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Branding: logo · crimson glow dot · AKARI TOOL mono wordmark (WPF parity).
                 TitleDotShadowHost is an empty layer behind the branding row that hosts the
                 dot's Composition glow (WinUI has no UIElement.Effect). -->
            <Grid Grid.Column="0" VerticalAlignment="Stretch">
                <Border x:ConnectionId='20' x:Name="TitleDotShadowHost"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:ConnectionId='21' x:Name="TitleLogo" Height="24" Stretch="Uniform"
                           VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <Ellipse x:ConnectionId='22' x:Name="TitleDot" Width="5" Height="5" VerticalAlignment="Center"
                             Margin="0,0,10,0" Fill="{ThemeResource AkariAccent}"/>
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                               FontWeight="Bold" VerticalAlignment="Center">
                        <Run Text="AKARI " Foreground="{ThemeResource AkariTextPrimary}"/><Run Text="TOOL" Foreground="{ThemeResource AkariAccent}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- Theme toggle (right, before the system caption buttons) -->
            <Button x:ConnectionId='18' x:Name="ThemeToggleBtn" Grid.Column="2"                          
                    Background="Transparent" BorderThickness="0"
                    Width="36" Height="32" Padding="0"
                    VerticalAlignment="Center" Margin="0,0,4,0"
                    ToolTipService.ToolTip="Toggle light / dark theme">
                <FontIcon x:ConnectionId='19' x:Name="ThemeToggleIcon" FontFamily="Segoe Fluent Icons"
                          Glyph="&#xE706;" FontSize="15"
                          Foreground="{ThemeResource AkariIconNeutral}"/>
            </Button>
        </Grid>

        <!-- ═══ Body: rail + content + log ═══ -->
        <muxc:NavigationView x:ConnectionId='4' x:Name="Nav" Grid.Row="1"
                             PaneDisplayMode="Left"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             OpenPaneLength="220"
                                                                    >

            <!-- Global "Find a setting" — searches every tab's tweaks via
                 TweakRegistry.Search and navigates to the hit. Replaces the WPF rail
                 TextBox + Popup + ListBox with a native AutoSuggestBox (built-in
                 suggestion dropdown). Only shown when the pane is expanded. -->
            <muxc:NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:ConnectionId='8' x:Name="GlobalSearch"
                                PlaceholderText="Find a setting"
                                QueryIcon="Find"
                                TextMemberPath="Name"
                                                                      
                                                                                
                                                                            >
                    <!-- Two-line suggestion (tweak name + tab), matching the WPF popup. -->
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3,2,3">
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TabLabel}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </muxc:NavigationView.AutoSuggestBox>
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Home" Tag="Home">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <!-- Tags MUST match the WPF routing contract (_subInfo): these two are
                     Software sub-panels, so their tags are Bloatware / AppInstaller. -->
                <muxc:NavigationViewItemHeader Content="SOFTWARE"/>
                <muxc:NavigationViewItem Content="Windows Apps" Tag="Bloatware">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="External Apps" Tag="AppInstaller">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE896;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Debloat" Tag="Debloat">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="OPTIMIZE"/>
                <muxc:NavigationViewItem Content="AkariOS" Tag="AkariOS">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE945;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Gaming &amp; Performance" Tag="Gaming">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Privacy &amp; Security" Tag="Privacy">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Windows Updates" Tag="Update">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE895;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Notifications" Tag="Notifications">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7E7;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Sound" Tag="Sound">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE767;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Power" Tag="Power">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE945;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <!-- Customize hosts SIX sub-panels (CustomizeTab.ShowPanel). The WPF rail
                     exposed each as a child item; reproduced natively via MenuItems. -->
                <muxc:NavigationViewItem Content="Customize" Tag="Customize">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE790;"/></muxc:NavigationViewItem.Icon>
                    <muxc:NavigationViewItem.MenuItems>
                        <muxc:NavigationViewItem Content="Taskbar"      Tag="Taskbar"/>
                        <muxc:NavigationViewItem Content="Explorer"     Tag="Explorer"/>
                        <muxc:NavigationViewItem Content="Context Menu" Tag="ContextMenu"/>
                        <muxc:NavigationViewItem Content="Appearance"   Tag="Appearance"/>
                        <muxc:NavigationViewItem Content="Start Menu"   Tag="StartMenu"/>
                        <muxc:NavigationViewItem Content="Desktop"      Tag="Desktop"/>
                    </muxc:NavigationViewItem.MenuItems>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Tools" Tag="Tools">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="ADVANCED"/>
                <muxc:NavigationViewItem Content="Advanced Tools" Tag="Advanced">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xEC7A;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Backup &amp; Restore" Tag="Backup">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE777;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Verify" Tag="Verify">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="App Updates" Tag="AppUpdate">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE896;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="About" Tag="About">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <!-- Content + log panel -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Drift banner: a row above the content, shown only when a scan
                     found tweaks that no longer match what Akari wrote. Content is
                     built in code (DriftBanner.Build) via RefreshDriftBanner. -->
                <ContentControl x:ConnectionId='10' x:Name="DriftBannerHost" Grid.Row="0"
                                HorizontalContentAlignment="Stretch"
                                Visibility="Collapsed"/>

                <Grid x:ConnectionId='11' x:Name="ContentHost" Grid.Row="1"/>

                <!-- ═══ Status + log panel ═══ -->
                <!-- Empty layer behind the log panel that hosts its card drop shadow
                     (WPF AkariCardShadow; WinUI has no UIElement.Effect). -->
                <Border x:ConnectionId='12' x:Name="LogShadowHost" Grid.Row="2"/>
                <Border x:ConnectionId='13' x:Name="TxtLogPanel" Grid.Row="2"
                        Background="{ThemeResource AkariLogSurface}"
                        BorderBrush="{ThemeResource AkariHairline}"
                        BorderThickness="0,1,0,0"
                        Padding="16,8,16,10">
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="LOG" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10" Foreground="{ThemeResource AkariTextMuted}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:ConnectionId='16' x:Name="TxtProgressStatus"
                                           Foreground="{ThemeResource AkariTextSecondary}" FontSize="12"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                                <muxc:ProgressBar x:ConnectionId='17' x:Name="LogProgress" Width="180" Height="4"
                                                  Minimum="0" Maximum="100" Value="0"
                                                  Visibility="Collapsed" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:ConnectionId='15' Grid.Column="3" x:Name="InfoDialogBtn"                         
                                    Background="Transparent" BorderThickness="0" Padding="6,2"
                                    ToolTipService.ToolTip="About Akari Tool">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="13"
                                          Foreground="{ThemeResource AkariIconNeutral}"/>
                            </Button>
                        </Grid>
                        <TextBox x:ConnectionId='14' x:Name="TxtLog" IsReadOnly="True" IsSpellCheckEnabled="False"
                                 Height="86" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </muxc:NavigationView>

        <!-- ═══ Status bar (WPF parity: green Ready dot + build stamp) ═══
             Full-width footer below the rail+content, matching the WPF row-4 status bar.
             StatusDotShadowHost carries the dot's green Composition glow. -->
        <Border Grid.Row="2" Background="{ThemeResource AkariSidebarBackground}"
                BorderThickness="0" Padding="16,5,16,5">
            <Grid VerticalAlignment="Center">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border x:ConnectionId='6' x:Name="StatusDotShadowHost"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:ConnectionId='7' x:Name="StatusDot" Width="6" Height="6" VerticalAlignment="Center"
                                 Margin="0,0,7,0" Fill="{ThemeResource AkariSuccess}"/>
                        <TextBlock Text="Ready" FontSize="11.5"
                                   Foreground="{ThemeResource AkariTextSecondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:ConnectionId='5' x:Name="BuildStamp" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                           Foreground="{ThemeResource AkariTextMuted}"/>
            </Grid>
        </Border>
    </Grid>
</Window>

