<Project>

  <!--
    The repo-root AkariTool.csproj (WinUI app) uses the SDK's default source globs,
    which sweep every **/*.cs under the repo root. The new class-library and test
    projects live under src\ and tests\, so without this exclude the app project would
    ALSO compile their files (pulling xunit/etc. into the app and breaking its build).

    DefaultItemExcludes patterns are evaluated relative to each project's own directory,
    so "src\**" / "tests\**" only match under the root project. The nested projects in
    src\... and tests\... don't have a src\ or tests\ subfolder of their own, so their
    globs are untouched — they still compile their own sources normally.

    Placed here (a new file) rather than editing AkariTool.csproj.
  -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);src\**;tests\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
